@inherits LayoutComponentBase
@implements IDisposable
@inject AppSession Session
@inject NavigationManager Nav

@if (Session.IsSignedIn)
{
    <div class="app">
        <div class="sidebar-backdrop @(_menuOpen ? "open" : "")" @onclick="() => _menuOpen = false"></div>
        <aside class="sidebar @(_menuOpen ? "open" : "")">
            <div class="brand"><Logo /></div>
            <nav class="nav" @onclick="() => _menuOpen = false">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All"><Icon Name="home" />Panel</NavLink>
                <NavLink class="nav-link" href="caja"><Icon Name="cart" />Vender</NavLink>
                <NavLink class="nav-link" href="ventas"><Icon Name="receipt" />Ventas</NavLink>
                <NavLink class="nav-link" href="turnos">
                    <Icon Name="@(_cashOpen ? "unlock" : "lock")" />Turnos de caja
                    @if (!_cashOpen)
                    {
                        <span class="count" title="La caja está cerrada">!</span>
                    }
                </NavLink>

                <div class="nav-section">Catálogo</div>
                <NavLink class="nav-link" href="articulos"><Icon Name="tag" />Artículos</NavLink>
                <NavLink class="nav-link" href="clientes"><Icon Name="users" />Clientes</NavLink>
                <NavLink class="nav-link" href="tiendas"><Icon Name="store" />Tiendas</NavLink>

                <div class="nav-section">Sistema</div>
                @if (Session.Can(PosPermissions.ViewAudit))
                {
                    <NavLink class="nav-link" href="auditoria"><Icon Name="list" />Auditoría</NavLink>
                }
                <NavLink class="nav-link" href="configuracion"><Icon Name="settings" />Configuración</NavLink>
            </nav>

            <div class="promo">
                <Logo IconOnly Size="64" />
                <h4 style="margin-top:8px">Libre y de código abierto</h4>
                <p>Vortex POS es AGPL-3.0. Hecho en Perú para LATAM y el mundo.</p>
                <button class="btn btn-accent btn-sm" @onclick="OpenRepoAsync">Contribuir</button>
            </div>
        </aside>

        <div class="main">
            <TopBar OnMenu="() => _menuOpen = !_menuOpen" />
            <div class="content">
                <ErrorBoundary @ref="_boundary">
                    @Body
                </ErrorBoundary>
            </div>
        </div>
    </div>
}

@code {
    private bool _menuOpen;
    private bool _cashOpen = true;
    private ErrorBoundary? _boundary;

    protected override void OnInitialized()
    {
        Session.Changed += OnSessionChanged;
        Session.DataChanged += OnDataChanged;
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!Session.IsSignedIn)
        {
            Nav.NavigateTo("login", replace: true);
            return;
        }
        await LoadCountsAsync();
    }

    private async Task LoadCountsAsync()
    {
        if (Session.Workspace is not { } pos)
            return;
        _cashOpen = await pos.Cash.GetOpenAsync() is not null;
    }

    private void OnSessionChanged() => _ = InvokeAsync(() =>
    {
        if (!Session.IsSignedIn)
            Nav.NavigateTo("login", replace: true);
        StateHasChanged();
    });

    private void OnDataChanged() => _ = InvokeAsync(async () =>
    {
        await LoadCountsAsync();
        StateHasChanged();
    });

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => _boundary?.Recover();

    private static Task OpenRepoAsync() => Launcher.Default.OpenAsync("https://github.com/ArcGabito/vortex-pos");

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
        Session.DataChanged -= OnDataChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
