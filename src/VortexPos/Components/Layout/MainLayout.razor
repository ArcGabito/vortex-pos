@inherits LayoutComponentBase
@implements IDisposable
@inject AppSession Session
@inject NavigationManager Nav
@inject BackButton Back
@inject IJSRuntime JS

@if (Session.IsSignedIn)
{
    <div class="app" @onclick="Session.Touch" @onkeydown="Session.Touch">
        <div class="sidebar-backdrop @(_menuOpen ? "open" : "")" @onclick="() => _menuOpen = false"></div>
        <aside class="sidebar @(_menuOpen ? "open" : "")">
            <div class="brand"><Logo /></div>
            <nav class="nav" @onclick="() => _menuOpen = false">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All"><Icon Name="home" />@T("nav.panel")</NavLink>
                <NavLink class="nav-link" href="caja"><Icon Name="cart" />@T("nav.vender")</NavLink>
                <NavLink class="nav-link" href="ventas"><Icon Name="receipt" />@T("nav.ventas")</NavLink>
                <NavLink class="nav-link" href="turnos">
                    <Icon Name="@(_cashOpen ? "unlock" : "lock")" />@T("nav.turnos_de_caja")
                    @if (!_cashOpen)
                    {
                        <span class="count" title="@(T("nav.la_caja_esta_cerrada"))">!</span>
                    }
                </NavLink>

                <div class="nav-section">@T("nav.catalogo")</div>
                <NavLink class="nav-link" href="articulos"><Icon Name="tag" />@T("nav.articulos")</NavLink>
                <NavLink class="nav-link" href="promociones"><Icon Name="star" />@T("nav.promociones")</NavLink>
                <NavLink class="nav-link" href="clientes"><Icon Name="users" />@T("nav.clientes")</NavLink>
                <NavLink class="nav-link" href="tiendas"><Icon Name="store" />@T("nav.tiendas")</NavLink>

                <div class="nav-section">@T("nav.sistema")</div>
                @if (Session.Can(PosPermissions.ViewAudit))
                {
                    <NavLink class="nav-link" href="auditoria"><Icon Name="list" />@T("nav.auditoria")</NavLink>
                }
                <NavLink class="nav-link" href="configuracion"><Icon Name="settings" />@T("nav.configuracion")</NavLink>
            </nav>

            <div class="promo">
                <h4>@T("nav.libre_de_codigo_abierto")</h4>
                <p>@T("nav.vortex_pos_es_agpl_3")</p>
                <div class="links">
                    <button class="btn btn-sm" @onclick="OpenRepoAsync"><Icon Name="external" Size="15" />@T("nav.contribuir")</button>
                </div>
            </div>
        </aside>

        <div class="main">
            <TopBar OnMenu="() => _menuOpen = !_menuOpen" />
            <div class="content">
                <ErrorBoundary @ref="_boundary">
                    @Body
                </ErrorBoundary>
                <footer class="app-foot">
                    <span>@T("nav.pie_derechos", DateTime.Now.Year)</span>
                    <div class="seals">
                        <span class="seal"><Icon Name="check" Size="15" Stroke="2.4" />@T("nav.codigo_abierto")</span>
                        <span class="seal"><Icon Name="check" Size="15" Stroke="2.4" />@T("nav.funciona_sin_conexion")</span>
                    </div>
                </footer>
            </div>
        </div>
    </div>
}

@if (Session.IsSignedIn && Session.IsLocked)
{
    <LockScreen />
}
<AuthorizeModal />

@code {
    private bool _menuOpen;
    private bool _cashOpen = true;
    private ErrorBoundary? _boundary;
    private IDisposable? _back;

    protected override void OnInitialized()
    {
        Session.Changed += OnSessionChanged;
        Session.DataChanged += OnDataChanged;
        Nav.LocationChanged += OnLocationChanged;
        _back = Back.Register(OnBack);
    }

    /// <summary>Atrás: cierra el menú; fuera del panel vuelve a la página anterior; en el panel deja salir de la app.</summary>
    private bool OnBack()
    {
        if (_menuOpen)
        {
            _ = InvokeAsync(() => { _menuOpen = false; StateHasChanged(); });
            return true;
        }
        if (!Session.IsSignedIn || Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Length == 0)
            return false;
        _ = InvokeAsync(async () => await JS.InvokeVoidAsync("history.back"));
        return true;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!Session.IsSignedIn)
        {
            Nav.NavigateTo("login", replace: true);
            return;
        }
        await LoadCountsAsync();
    }

    private async Task LoadCountsAsync()
    {
        if (Session.Workspace is not { } pos)
            return;
        _cashOpen = await pos.Cash.GetOpenAsync() is not null;
    }

    private void OnSessionChanged() => _ = InvokeAsync(() =>
    {
        if (!Session.IsSignedIn)
            Nav.NavigateTo("login", replace: true);
        StateHasChanged();
    });

    private void OnDataChanged() => _ = InvokeAsync(async () =>
    {
        await LoadCountsAsync();
        StateHasChanged();
    });

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => _boundary?.Recover();

    private static Task OpenRepoAsync() => Launcher.Default.OpenAsync("https://github.com/ArcGabito/vortex-pos");

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
        Session.DataChanged -= OnDataChanged;
        Nav.LocationChanged -= OnLocationChanged;
        _back?.Dispose();
    }
}
