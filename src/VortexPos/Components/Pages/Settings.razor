@page "/configuracion"
@inherits PosPage
@using VortexApi.Client.Sync

<SectionContent SectionName="page-title">@T("settings.configuracion")</SectionContent>

<div class="page">
    <div class="page-head">
        <div>
            <h2>@T("settings.configuracion")</h2>
            <p>@T("settings.tu_cuenta_la_conexion_con")</p>
        </div>
    </div>

    <div class="grid-2">
        <div style="display:flex;flex-direction:column;gap:20px;min-width:0">
            <div class="card">
                <div class="card-head">
                    <div>
                        <h3>@T("settings.sincronizacion")</h3>
                        <div class="sub">@T("settings.todo_se_guarda_primero_en")</div>
                    </div>
                    <button class="btn btn-dark btn-sm" disabled="@Session.Sync.IsSyncing" @onclick="Session.SyncNow"><Icon Name="sync" Size="16" />@T("settings.sincronizar_ahora")</button>
                </div>
                <div class="card-body">
                    <div class="list-row">
                        <span>@T("settings.estado")</span>
                        <span class="end"><span class="pill @ConnectionTone">@ConnectionText</span></span>
                    </div>
                    <div class="list-row">
                        <span>@T("settings.ultima_sincronizacion")</span>
                        <span class="end strong" style="font-weight:600">@(Session.Sync.LastSyncAt is { } at ? Fmt.DateTime(at) : T("settings.aun_no"))</span>
                    </div>
                    <div class="list-row">
                        <span>@T("settings.operaciones_por_subir")</span>
                        <strong class="end">@Session.Sync.Pending</strong>
                    </div>
                    @if (Session.Sync.LastResult is { } r)
                    {
                        <div class="list-row">
                            <span>@T("settings.ultima_vuelta")</span>
                            <span class="end muted">@(Fmt.Count(r.PushedEvents + r.PushedMasterWrites, T("settings.envio"), T("settings.envios"))) · @(Fmt.Count(r.PulledChanges + r.PulledEvents, T("count.recibido"), T("count.recibidos")))</span>
                        </div>
                    }
                    @if (Session.Connection == ConnectionState.Offline && Session.OfflineValidUntil is { } until)
                    {
                        <div class="alert warn" style="margin-top:12px"><Icon Name="wifi-off" Size="18" /><span>@T("settings.sin_conexion_puedes_seguir_trabajando", Fmt.DateTime(until))</span></div>
                    }
                    @if (Session.Sync.LastError is { } error)
                    {
                        <div class="alert error" style="margin-top:12px"><Icon Name="alert" Size="18" /><span>@error</span></div>
                    }
                </div>
            </div>

            <div class="card">
                <div class="card-head">
                    <div>
                        <h3>@T("settings.rechazadas_por_el_hub")</h3>
                        <div class="sub">@T("settings.operaciones_que_el_hub_no")</div>
                    </div>
                </div>
                <div class="card-body">
                    @if (_failed.Count == 0)
                    {
                        <div class="list-row"><Icon Name="check" Size="18" Class="faint" /><span class="muted">@T("settings.no_hay_operaciones_rechazadas")</span></div>
                    }
                    @foreach (var f in _failed)
                    {
                        <div class="list-row" @key="f.Entry.Id" style="align-items:flex-start">
                            <div class="two-line" style="flex:1">
                                <span class="t1">@Describe(f.Entry)</span>
                                <span class="t2" style="white-space:normal">@HubErrors.ForFailed(f.ErrorCode, f.Error)</span>
                                <span class="t2">@Fmt.DateTime(f.FailedAt)</span>
                            </div>
                            <button class="btn btn-sm" @onclick="() => DismissAsync(f)">@T("settings.descartar")</button>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div style="display:flex;flex-direction:column;gap:20px;min-width:0">
            <div class="card">
                <div class="card-head"><h3>@T("settings.cuenta")</h3></div>
                <div class="card-body">
                    @if (Session.Session is { } s)
                    {
                        <div class="list-row">
                            <Avatar Text="@s.User.FullName" Size="44" Class="user" />
                            <div class="two-line">
                                <span class="t1">@s.User.FullName</span>
                                <span class="t2">@s.User.Email</span>
                            </div>
                        </div>
                        <dl class="kv" style="margin:12px 0 16px">
                            <dt>@T("settings.organizacion")</dt>
                            <dd>@s.Access.OrganizationName</dd>
                            <dt>@T("settings.rol_en_el_pos")</dt>
                            <dd>@RoleLabel(Session.Role)<div class="muted" style="font-weight:500">@T("settings.lo_asigna_el_administrador_de")</div></dd>
                        </dl>
                    }
                    <button class="btn btn-danger btn-sm" @onclick="() => Session.SignOutAsync()"><Icon Name="logout" Size="16" />@T("settings.cerrar_sesion")</button>
                </div>
            </div>

            <div class="card">
                <div class="card-head"><h3>@T("settings.este_equipo")</h3></div>
                <div class="card-body">
                    <div class="field" style="margin-bottom:14px">
                        <label>@T("settings.language")</label>
                        <select class="select" value="@(Session.LanguagePreference ?? "")" @onchange="e => Session.SetLanguageAsync(e.Value?.ToString())">
                            <option value="">@T("settings.idioma_del_pais")</option>
                            @foreach (var language in VortexApi.Suite.Regional.Languages.Supported)
                            {
                                <option value="@language">@VortexApi.Suite.Regional.Languages.NameOf(language)</option>
                            }
                        </select>
                    </div>
                    <div class="field" style="margin-bottom:14px">
                        <label>@T("settings.tienda_de_esta_caja")</label>
                        <select class="select" value="@Session.DefaultSiteId" @onchange="e => Session.SetDefaultSite(Guid.TryParse(e.Value?.ToString(), out var g) ? g : null)">
                            <option value="">@T("settings.la_primera_tienda_activa")</option>
                            @foreach (var site in _sites)
                            {
                                <option value="@site.Id">@site.Name</option>
                            }
                        </select>
                    </div>
                    <dl class="kv">
                        <dt>@T("settings.servidor_del_hub")</dt>
                        <dd>@Session.HubUrl</dd>
                        <dt>@T("settings.prefijo_de_documentos")</dt>
                        <dd>@Session.DeviceTag<div class="muted" style="font-weight:500">@T("settings.ej_000001", Session.DeviceTag)</div></dd>
                        <dt>@T("settings.id_del_equipo")</dt>
                        <dd>@Session.DeviceId</dd>
                        @if (Session.Session is { } s2)
                        {
                            <dt>@T("settings.acceso_sin_conexion")</dt>
                            <dd>@T("settings.hasta_el", Fmt.DateTime(s2.OfflineTokenExpiresAt))</dd>
                        }
                    </dl>
                </div>
            </div>

            <div class="card">
                <div class="card-head">
                    <div>
                        <h3>@T("settings.mi_pin")</h3>
                        <div class="sub">@T("settings.mi_pin_explica")</div>
                    </div>
                </div>
                <div class="card-body" style="display:flex;flex-direction:column;gap:12px">
                    @if (Session.Operator is { } op)
                    {
                        @* El PIN se cambia con la contraseña de quien inició sesión; otro cajero lo hace desde su propia sesión. *@
                        <span class="muted" style="font-size:12.5px">@T("settings.mi_pin_otro_cajero", op.Name, Session.Session?.User.FullName ?? "")</span>
                    }
                    else
                    {
                        <div class="form-row">
                            <div class="field">
                                <label>@T("settings.contrasena_actual")</label>
                                <input class="control" type="password" autocomplete="current-password" @bind="_pinPassword" />
                            </div>
                            <div class="field">
                                <label>@T("settings.pin_nuevo")</label>
                                <input class="control" type="password" inputmode="numeric" maxlength="8" autocomplete="off" @bind="_pin" />
                            </div>
                        </div>
                        <div style="display:flex;gap:8px;flex-wrap:wrap">
                            <button class="btn btn-dark btn-sm" disabled="@_busyPin" @onclick="() => SavePinAsync(_pin)">@T("settings.guardar_pin")</button>
                            <button class="btn btn-sm" disabled="@_busyPin" @onclick="() => SavePinAsync(null)">@T("settings.quitar_pin")</button>
                        </div>
                    }
                    <div class="field" style="max-width:260px">
                        <label>@T("settings.bloquear_la_caja_tras")</label>
                        <select class="select" value="@Session.LockMinutes" @onchange="e => Session.LockMinutes = int.TryParse(e.Value?.ToString(), out var m) ? m : 0">
                            @foreach (var m in new[] { 0, 2, 5, 10, 15, 30 })
                            {
                                <option value="@m">@(m == 0 ? T("settings.nunca") : T("settings.minutos_sin_uso", m))</option>
                            }
                        </select>
                    </div>
                    @if (!Session.Desk.HasPins)
                    {
                        <span class="muted" style="font-size:12.5px">@T("settings.sin_pines_explica")</span>
                    }
                </div>
            </div>

            <div class="card">
                <div class="card-head">
                    <div>
                        <h3>@T("settings.impresora_de_tickets")</h3>
                        <div class="sub">@T("settings.impresora_explica")</div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="form-row">
                        <div class="field">
                            <label>@T("settings.direccion_ip")</label>
                            <input class="control" placeholder="192.168.1.50" @bind="_printerHost" />
                        </div>
                        <div class="field">
                            <label>@T("settings.puerto")</label>
                            <input class="control" type="number" min="1" max="65535" @bind="_printerPort" />
                        </div>
                    </div>
                    <div style="display:flex;gap:8px;margin-top:14px;flex-wrap:wrap">
                        <button class="btn btn-dark btn-sm" @onclick="SavePrinter">@T("settings.guardar")</button>
                        @if (Printer.IsConfigured)
                        {
                            <button class="btn btn-sm" @onclick="TestPrinterAsync"><Icon Name="receipt" Size="16" />@T("settings.imprimir_prueba")</button>
                        }
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-head">
                    <div>
                        <h3>@T("settings.comprobante_electronico")</h3>
                        <div class="sub">@T("settings.comprobante_explica")</div>
                    </div>
                </div>
                <div class="card-body">
                    @if (_fiscal.Enabled)
                    {
                        <div class="alert info"><Icon Name="check" Size="18" /><span>@T("settings.emite_comprobantes", _fiscal.Series!.ReceiptSeries, _fiscal.Series.InvoiceSeries)</span></div>
                    }
                    else if (_fiscal.Reason is { } motivo)
                    {
                        <div class="alert warn"><Icon Name="alert" Size="18" /><span>@motivo</span></div>
                    }
                    <div class="form-row">
                        <div class="field">
                            <label>@T("settings.serie_boletas")</label>
                            <input class="control" maxlength="4" placeholder="B001" @bind="_receiptSeries" disabled="@(!Session.Can(PosPermissions.StoreSettings))" />
                        </div>
                        <div class="field">
                            <label>@T("settings.serie_facturas")</label>
                            <input class="control" maxlength="4" placeholder="F001" @bind="_invoiceSeries" disabled="@(!Session.Can(PosPermissions.StoreSettings))" />
                        </div>
                    </div>
                    <span class="muted" style="font-size:12.5px">@T("settings.series_explica")</span>
                    @if (Session.Can(PosPermissions.StoreSettings))
                    {
                        <div style="display:flex;gap:8px;margin-top:14px;flex-wrap:wrap">
                            <button class="btn btn-dark btn-sm" @onclick="SaveSeriesAsync">@T("settings.guardar")</button>
                        </div>
                    }
                </div>
            </div>

            @if (Session.Can(PosPermissions.StoreSettings) && _storeId is not null)
            {
                <div class="card">
                    <div class="card-head">
                        <div>
                            <h3>@T("settings.tienda_y_tickets")</h3>
                            <div class="sub">@T("settings.tienda_explica")</div>
                        </div>
                    </div>
                    <div class="card-body" style="display:flex;flex-direction:column;gap:14px">
                        <div class="field">
                            <label>@T("settings.tienda")</label>
                            <select class="select" value="@_storeId" @onchange="e => SelectStoreAsync(e.Value?.ToString())">
                                @foreach (var site in _sites)
                                {
                                    <option value="@site.Id">@site.Name</option>
                                }
                            </select>
                        </div>
                        <div class="field">
                            <label>@T("settings.encabezado_del_ticket")</label>
                            <textarea class="control" rows="3" placeholder="@(T("settings.ej_direccion_y_telefono"))" @bind="_store.Header"></textarea>
                        </div>
                        <div class="field">
                            <label>@T("settings.pie_del_ticket")</label>
                            <textarea class="control" rows="2" placeholder="@(T("settings.ej_gracias_por_su_compra"))" @bind="_store.Footer"></textarea>
                        </div>
                        <div class="field">
                            <label>@T("settings.ancho_del_papel")</label>
                            <select class="select" @bind="_store.Columns">
                                <option value="32">@T("settings.papel_58")</option>
                                <option value="42">@T("settings.papel_76")</option>
                                <option value="48">@T("settings.papel_80")</option>
                            </select>
                        </div>
                        <label class="check"><input type="checkbox" @bind="_store.PrintAutomatically" />@T("settings.imprimir_al_cobrar")</label>
                        <label class="check"><input type="checkbox" @bind="_store.OpenDrawer" />@T("settings.abrir_cajon_en_efectivo")</label>
                        <label class="check"><input type="checkbox" @bind="_store.BlindClose" />@T("settings.cierre_ciego")</label>
                        <label class="check"><input type="checkbox" @bind="_store.ScaleLabels" />@T("settings.etiquetas_de_balanza")</label>
                        @if (_store.ScaleLabels)
                        {
                            <div class="grid-2">
                                <div class="field">
                                    <label>@T("settings.la_etiqueta_trae")</label>
                                    <select class="select" @bind="_store.ScaleMode">
                                        <option value="@ScaleLabel.Weight">@T("settings.balanza_peso")</option>
                                        <option value="@ScaleLabel.Price">@T("settings.balanza_precio")</option>
                                    </select>
                                </div>
                                <div class="field">
                                    <label>@T("settings.digitos_del_codigo")</label>
                                    <select class="select" @bind="_store.ScaleDigits">
                                        @for (var d = ScaleLabel.MinItemDigits; d <= ScaleLabel.MaxItemDigits; d++)
                                        {
                                            <option value="@d">@d</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <p class="hint">@T("settings.balanza_explica", ScaleLabel.Build("20", "123", _store.ScaleMode == ScaleLabel.Price ? 1250 : 750, _store.ScaleDigits))</p>
                        }
                        <div><button class="btn btn-dark btn-sm" @onclick="SaveStoreAsync">@T("settings.guardar")</button></div>
                    </div>
                </div>
            }

            <div class="card">
                <div class="card-head"><h3>@T("settings.acerca_de")</h3></div>
                <div class="card-body">
                    <div class="list-row">
                        <Logo Size="30" />
                        <span class="end muted">@T("settings.version", Version)</span>
                    </div>
                    <p class="muted" style="font-size:13px;line-height:1.6;margin:10px 0 14px">
                        @T("settings.vortex_pos_es_software_libre")
                        <strong>@T("settings.gnu_agpl_3_0")</strong>@T("settings.si_lo_ofreces_como_servicio")
                        @T("settings.tipografia_montserrat_bajo_la_sil")
                    </p>
                    <div style="display:flex;gap:8px;flex-wrap:wrap">
                        <button class="btn btn-sm" @onclick="() => OpenAsync(SourceUrl)"><Icon Name="external" Size="16" />@T("settings.codigo_fuente")</button>
                        <button class="btn btn-sm" @onclick="() => OpenAsync(IssuesUrl)"><Icon Name="heart" Size="16" />@T("settings.reportar_sugerir")</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private const string SourceUrl = "https://github.com/ArcGabito/vortex-pos";
    private const string IssuesUrl = SourceUrl + "/issues";
    private static readonly string Version = AppInfo.Current.Version.ToString(3);

    private sealed class StoreForm
    {
        public string? Header { get; set; }
        public string? Footer { get; set; }
        public int Columns { get; set; } = 48;
        public bool PrintAutomatically { get; set; } = true;
        public bool OpenDrawer { get; set; } = true;
        public bool BlindClose { get; set; }
        public bool ScaleLabels { get; set; }
        public string ScaleMode { get; set; } = ScaleLabel.Weight;
        public int ScaleDigits { get; set; } = 5;

        public static StoreForm From(StoreSettings s) => new()
        {
            Header = s.TicketHeader, Footer = s.TicketFooter, Columns = s.PaperColumns, PrintAutomatically = s.PrintAutomatically,
            OpenDrawer = s.OpenDrawerOnCash, BlindClose = s.BlindClose, ScaleLabels = s.ScaleLabels, ScaleMode = s.ScaleLabelMode,
            ScaleDigits = s.ScaleItemDigits,
        };

        public StoreSettings ToSettings() => new(Header, Footer, Columns, BlindClose, PrintAutomatically, OpenDrawer, ScaleLabels, ScaleMode, ScaleDigits);
    }

    private IReadOnlyList<VortexFailedEntry> _failed = [];
    private IReadOnlyList<SiteRow> _sites = [];
    private string? _pinPassword, _pin;
    private bool _busyPin;

    private async Task SavePinAsync(string? pin)
    {
        _busyPin = true;
        var error = await Session.SetMyPinAsync(_pinPassword ?? "", pin);
        _busyPin = false;
        if (error is not null)
        {
            Toasts.Error(error);
            return;
        }
        (_pinPassword, _pin) = (null, null);
        Toasts.Success(pin is null ? T("settings.pin_quitado") : T("settings.pin_guardado"));
    }

    private string? _printerHost;
    private int _printerPort = TicketPrinter.DefaultPort;
    private Guid? _storeId;
    private StoreForm _store = new();

    protected override void OnInitialized()
    {
        Session.Changed += OnSessionChanged;
        _printerHost = Printer.Host;
        _printerPort = Printer.Port;
    }

    private FiscalSetup _fiscal = new(false, null, null);
    private string? _receiptSeries, _invoiceSeries;

    private async Task SaveSeriesAsync()
    {
        await RunAsync(() => Pos.Fiscal.SaveSeriesAsync(new FiscalSeries(_receiptSeries ?? "", _invoiceSeries ?? "")), T("settings.series_guardadas"));
        _fiscal = await Pos.Fiscal.GetSetupAsync();
    }

    protected override async Task LoadAsync()
    {
        _fiscal = await Pos.Fiscal.GetSetupAsync();
        _receiptSeries ??= _fiscal.Series?.ReceiptSeries;
        _invoiceSeries ??= _fiscal.Series?.InvoiceSeries;
        _sites = (await Pos.Master.GetSitesAsync(activeOnly: true))
            .Where(s => Session.SiteIds.Count == 0 || Session.SiteIds.Contains(s.Id)).ToList();
        _failed = await Session.GetFailedAsync();
        _storeId ??= _sites.FirstOrDefault(s => s.Id == Session.DefaultSiteId)?.Id
            ?? _sites.FirstOrDefault(s => s.Kind == "Store")?.Id ?? _sites.FirstOrDefault()?.Id;
        if (_storeId is { } id)
            _store = StoreForm.From(await Pos.Stores.GetAsync(id));
    }

    private async Task SelectStoreAsync(string? value)
    {
        if (!Guid.TryParse(value, out var id))
            return;
        _storeId = id;
        _store = StoreForm.From(await Pos.Stores.GetAsync(id));
    }

    private async Task SaveStoreAsync()
    {
        if (_storeId is { } id)
            await RunAsync(() => Pos.Stores.SaveAsync(id, _store.ToSettings()), T("settings.configuracion_guardada"));
    }

    private void SavePrinter()
    {
        Printer.Configure(_printerHost, _printerPort);
        _printerHost = Printer.Host;
        _printerPort = Printer.Port;
        Toasts.Success(Printer.IsConfigured ? T("settings.impresora_guardada") : T("settings.impresora_quitada"));
    }

    private async Task TestPrinterAsync()
    {
        var settings = _storeId is { } id ? await Pos.Stores.GetAsync(id) : StoreSettings.Default;
        var lines = new List<VortexPos.Core.Printing.TicketLine>
        {
            new("Vortex POS", VortexPos.Core.Printing.TicketAlign.Center, Bold: true, Large: true),
            new(T("settings.prueba_de_impresion"), VortexPos.Core.Printing.TicketAlign.Center),
            new(new string('-', settings.PaperColumns)),
            new(Fmt.DateTime(DateTimeOffset.UtcNow)),
            new($"{Printer.Host}:{Printer.Port} · {settings.PaperColumns} col."),
        };
        if (await Printer.PrintAsync(new VortexPos.Core.Printing.TicketDocument(lines, settings.PaperColumns)) is { } error)
            Toasts.Error(error);
        else
            Toasts.Success(T("settings.prueba_enviada"));
    }

    private void OnSessionChanged() => _ = InvokeAsync(async () =>
    {
        await ReloadAsync();
        StateHasChanged();
    });

    private string ConnectionText => Session.Connection switch
    {
        ConnectionState.Online => T("settings.en_linea"),
        ConnectionState.Offline => T("settings.sin_conexion"),
        ConnectionState.OfflineExpired => T("settings.periodo_sin_conexion_agotado"),
        _ => T("settings.conectando"),
    };

    private string ConnectionTone => Session.Connection switch
    {
        ConnectionState.Online => "good",
        ConnectionState.Offline => "warn",
        ConnectionState.OfflineExpired => "bad",
        _ => "neutral",
    };

    // Roles del hub (UserRole) y los que un administrador asigne al acceso del POS, que se muestran tal cual.
    private static string RoleLabel(string? role) => role switch
    {
        "User" => T("settings.usuario"),
        "OrgAdmin" => T("settings.administrador_de_la_organizacion"),
        "PlatformAdmin" => T("settings.administrador_de_la_plataforma"),
        "administrador" => T("settings.administrador"),
        "supervisor" => T("settings.supervisor"),
        "cajero" => T("settings.cajero"),
        null or "" => "—",
        _ => role,
    };

    private static string Describe(VortexOutboxEntry e) => e.Kind == VortexOutboxKind.Event
        ? $"Evento {e.EventType}{(e.SubjectId is null ? "" : $" · {e.SubjectId}")}"
        : $"{e.Resource switch { "items" => T("settings.articulo"), "sites" => T("settings.sede"), "parties" => T("settings.cliente_proveedor"), var other => other }} "
          + (e.ExpectedVersion is null ? "nuevo" : "editado");

    private async Task DismissAsync(VortexFailedEntry entry)
    {
        await Session.DismissFailedAsync(entry.Entry.Id);
        Toasts.Info(T("settings.operacion_descartada_si_era_un"));
    }

    private static async Task OpenAsync(string url) => await Launcher.Default.OpenAsync(new Uri(url));

    public override void Dispose()
    {
        Session.Changed -= OnSessionChanged;
        base.Dispose();
    }
}
