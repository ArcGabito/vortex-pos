@page "/turnos"
@inherits PosPage
@using VortexPos.Core.Printing

<SectionContent SectionName="page-title">@T("cashsessions.turnos_de_caja")</SectionContent>

<div class="page">
    <div class="page-head">
        <div>
            <h2>@T("cashsessions.turnos_de_caja")</h2>
            <p>@T("cashsessions.abre_la_caja_con_el")</p>
        </div>
        @if (_open is null && !Loading)
        {
            <button class="btn btn-dark" @onclick="StartOpen"><Icon Name="unlock" Size="18" />@T("cashsessions.abrir_caja")</button>
        }
    </div>

    @if (_open is { } s && _summary is { } sum)
    {
        <div class="card">
            <div class="card-head" style="flex-wrap:wrap">
                <div>
                    <h3>@T("cashsessions.caja_abierta", s.Number)</h3>
                    <div class="sub">@T("cashsessions.desde_el", s.SiteName, Fmt.DateTime(s.OpenedAt), (s.OpenedBy is null ? "" : T("cashsessions.por", s.OpenedBy)))</div>
                </div>
                <div style="display:flex;gap:8px;flex-wrap:wrap">
                    <a class="btn btn-sm" href="caja"><Icon Name="cart" Size="16" />@T("cashsessions.vender")</a>
                    @if (Session.CanOrApprove(PosPermissions.CashMovement))
                    {
                        <button class="btn btn-sm" @onclick="() => StartMovement(CashMovementKinds.In)"><Icon Name="plus" Size="16" />@T("cashsessions.ingreso")</button>
                        <button class="btn btn-sm" @onclick="() => StartMovement(CashMovementKinds.Out)"><Icon Name="minus" Size="16" />@T("cashsessions.retiro")</button>
                        <button class="btn btn-sm" @onclick="() => StartMovement(CashMovementKinds.Deposit)"><Icon Name="bank" Size="16" />@T("cashsessions.deposito")</button>
                        @if (Printer.IsConfigured)
                        {
                            <button class="btn btn-sm" @onclick="OpenDrawerAsync"><Icon Name="unlock" Size="16" />@T("cashsessions.abrir_cajon")</button>
                        }
                    }
                    @if (Session.CanOrApprove(PosPermissions.CashReport))
                    {
                        <button class="btn btn-sm" @onclick="() => ShowReportAsync(s.Id)"><Icon Name="list" Size="16" />@T("cashsessions.reporte_x")</button>
                    }
                    @if (Session.CanOrApprove(PosPermissions.CloseCash))
                    {
                        <button class="btn btn-dark btn-sm" @onclick="StartClose"><Icon Name="lock" Size="16" />@T("cashsessions.cerrar_caja")</button>
                    }
                </div>
            </div>
            <div class="stat-strip boxed" style="margin:0 20px 18px">
                <StatTile Icon="receipt" Label="@(T("cashsessions.ventas_del_turno"))" Value="@Fmt.Compact(sum.Sales)" Hint="@Fmt.Money(sum.SalesTotal, Currency)" />
                <StatTile Icon="cash" Label="@(T("cashsessions.fondo_inicial"))" Value="@Fmt.Money(sum.OpeningFloat, Currency)" />
                @if (ShowExpected)
                {
                    <StatTile Icon="cash" Label="@(T("cashsessions.cobrado_en_efectivo"))" Value="@Fmt.Money(sum.CashSales, Currency)" Hint="@(sum.CashRefunds > 0 ? T("cashsessions.en_devoluciones", (Fmt.Money(sum.CashRefunds, Currency))) : null)" />
                    <StatTile Icon="wallet" Label="@(T("cashsessions.efectivo_esperado"))" Value="@Fmt.Money(sum.ExpectedCash, Currency)" />
                    @foreach (var extranjera in sum.ForeignCash ?? new Dictionary<string, decimal>())
                    {
                        <StatTile Icon="cash" Label="@(T("cashsessions.efectivo_en", extranjera.Key))" Value="@Fmt.Money(extranjera.Value, extranjera.Key)" />
                    }
                }
                @if (sum.Tips > 0)
                {
                    <StatTile Icon="star" Label="@(T("cashsessions.propinas"))" Value="@Fmt.Money(sum.Tips, Currency)"
                              Hint="@string.Join(" · ", (sum.TipsByPerson ?? new Dictionary<string, decimal>()).Select(x => $"{x.Key} {Fmt.Money(x.Value, Currency)}"))" />
                }
            </div>
            @if (sum.ByMethod.Count > 0 || _movements.Count > 0)
            {
                <div class="card-body">
                    @foreach (var (method, amount) in sum.ByMethod.OrderByDescending(m => m.Value))
                    {
                        <div class="list-row">
                            <Icon Name="@Fmt.PaymentIcon(method)" Size="18" Class="faint" />
                            <span>@Fmt.PaymentMethod(method)</span>
                            <strong class="end">@Fmt.Money(amount, Currency)</strong>
                        </div>
                    }
                    @foreach (var m in _movements)
                    {
                        <div class="list-row" @key="m.Id">
                            <Icon Name="@(m.Kind == CashMovementKinds.In ? "plus" : "minus")" Size="18" Class="faint" />
                            <div class="two-line">
                                <span class="t1" style="font-weight:600">@(m.Kind == CashMovementKinds.In ? T("cashsessions.ingreso") : m.Kind == CashMovementKinds.Deposit ? T("cashsessions.deposito") : T("cashsessions.retiro")): @m.Reason</span>
                                <span class="t2">@Fmt.Time(m.CreatedAt)@(m.UserName is null ? "" : $" · {m.UserName}")</span>
                            </div>
                            <strong class="end @(m.Kind == CashMovementKinds.In ? "qty-pos" : "qty-neg")">@(m.Kind == CashMovementKinds.In ? "+" : "−")@Fmt.Money(m.Amount, Currency)</strong>
                        </div>
                    }
                </div>
            }
        </div>
    }
    else if (!Loading)
    {
        <div class="alert info"><Icon Name="lock" Size="18" /><span>@T("cashsessions.la_caja_de_este_equipo")</span></div>
    }

    <div class="card">
        <div class="card-head"><h3>@T("cashsessions.historial_de_turnos")</h3></div>
        <div class="card-body" style="padding-top:0">
            @if (_history is { Total: 0 })
            {
                <EmptyState Icon="clock" Title="@(T("cashsessions.aun_no_hay_turnos"))" Text="@(T("cashsessions.cada_apertura_cierre_de_esta"))" />
            }
            else if (_history is { } h)
            {
                <div class="table-wrap">
                    <table class="data">
                        <thead>
                            <tr><th>@T("cashsessions.turno")</th><th>@T("cashsessions.apertura")</th><th>@T("cashsessions.cierre")</th><th class="num">@T("cashsessions.ventas")</th><th class="num">@T("cashsessions.esperado")</th><th class="num">@T("cashsessions.contado")</th><th class="num">@T("cashsessions.diferencia")</th><th class="actions-col"></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var t in h.Items)
                            {
                                <tr @key="t.Id">
                                    <td><div class="two-line"><span class="t1">@t.Number</span><span class="t2">@t.SiteName</span></div></td>
                                    <td><div class="two-line"><span class="t1" style="font-weight:600">@Fmt.DateTime(t.OpenedAt)</span><span class="t2">@t.OpenedBy</span></div></td>
                                    <td>
                                        @if (t.ClosedAt is { } closed)
                                        {
                                            <div class="two-line"><span class="t1" style="font-weight:600">@Fmt.DateTime(closed)</span><span class="t2">@t.ClosedBy</span></div>
                                        }
                                        else
                                        {
                                            <StatusPill Text="@(T("cashsessions.abierta"))" Tone="good" />
                                        }
                                    </td>
                                    <td class="num">@Fmt.Money(t.SalesTotal, Currency)<div class="muted" style="font-size:12px">@Fmt.Count(t.Sales, T("count.venta"), T("count.ventas"))</div></td>
                                    <td class="num">@(t.ExpectedCash is { } e ? Fmt.Money(e, Currency) : "—")</td>
                                    <td class="num">@(t.CountedCash is { } c ? Fmt.Money(c, Currency) : "—")</td>
                                    <td class="num">
                                        @if (t.Difference is { } diff)
                                        {
                                            <span class="@(diff == 0 ? "qty-pos" : "qty-neg")" title="@t.Note">@(diff > 0 ? "+" : "")@Fmt.Money(diff, Currency)</span>
                                        }
                                        else
                                        {
                                            <span class="faint">—</span>
                                        }
                                    </td>
                                    <td class="actions-col">
                                        @if (t.ClosedAt is not null && Session.CanOrApprove(PosPermissions.CashReport))
                                        {
                                            <button class="btn btn-ghost btn-sm" @onclick="() => ShowReportAsync(t.Id)" title="@(T("cashsessions.reporte_z"))">Z</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <Pager Page="h.Page" PageSize="h.PageSize" Total="h.Total" Noun="@(T("cashsessions.turnos"))" OnPage="async p => { _page = p; await ReloadAsync(); }" />
            }
        </div>
    </div>
</div>

@if (_opening)
{
    <Modal Title="@(T("cashsessions.abrir_caja"))" Subtitle="@(_storeName is null ? T("cashsessions.elige_primero_la_tienda_de") : T("cashsessions.tienda", _storeName))" Size="sm" Error="@_error" OnClose="() => _opening = false">
        <ChildContent>
            <div class="field">
                <label>@T("cashsessions.fondo_inicial_en_efectivo", Fmt.Symbol(Currency))</label>
                <input class="control" type="number" min="0" step="0.10" @bind="_amount" />
            </div>
        </ChildContent>
        <Footer>
            <button class="btn" @onclick="() => _opening = false">@T("cashsessions.cancelar")</button>
            <button class="btn btn-dark" disabled="@_busy" @onclick="OpenAsync">@T("cashsessions.abrir_caja")</button>
        </Footer>
    </Modal>
}

@if (_movementKind is { } kind)
{
    <Modal Title="@(kind == CashMovementKinds.In ? T("cashsessions.ingreso_de_efectivo") : kind == CashMovementKinds.Deposit ? T("cashsessions.deposito_en_banco") : T("cashsessions.retiro_de_efectivo"))"
           Subtitle="@(kind == CashMovementKinds.In ? T("cashsessions.efectivo_que_entra_al_cajon") : kind == CashMovementKinds.Deposit ? T("cashsessions.deposito_explica") : T("cashsessions.efectivo_que_sale_del_cajon"))"
           Size="sm" Error="@_error" OnClose="() => _movementKind = null">
        <ChildContent>
            <div class="field">
                <label>@T("cashsessions.monto", Fmt.Symbol(Currency))</label>
                <input class="control" type="number" min="0" step="0.10" @bind="_amount" />
            </div>
            <div class="field">
                <label>@T("cashsessions.motivo")</label>
                <input class="control" placeholder="@(kind == CashMovementKinds.In ? T("cashsessions.ej_sencillo_del_banco") : T("cashsessions.ej_deposito_al_banco"))" @bind="_note" />
            </div>
            @if (kind == CashMovementKinds.Deposit)
            {
                <div class="form-row">
                    <div class="field"><label>@T("cashsessions.banco")</label><input class="control" @bind="_bank" /></div>
                    <div class="field"><label>@T("cashsessions.nro_operacion")</label><input class="control" @bind="_reference" /></div>
                </div>
            }
        </ChildContent>
        <Footer>
            <button class="btn" @onclick="() => _movementKind = null">@T("cashsessions.cancelar")</button>
            <button class="btn btn-dark" disabled="@_busy" @onclick="AddMovementAsync">@T("cashsessions.registrar")</button>
        </Footer>
    </Modal>
}

@if (_closing && _summary is { } cs)
{
    <Modal Title="@(T("cashsessions.cerrar_caja"))" Subtitle="@(T("cashsessions.cuenta_el_efectivo_del_cajon"))" Size="@(_byDenomination ? null : "sm")" Error="@_error" OnClose="() => _closing = false">
        <ChildContent>
            @if (!_store.BlindClose)
            {
                <dl class="totals">
                    <dt>@T("cashsessions.efectivo_esperado")</dt><dd>@Fmt.Money(cs.ExpectedCash, Currency)</dd>
                    @foreach (var aparte in cs.ForeignCash ?? new Dictionary<string, decimal>())
                    {
                        <dt>@T("cashsessions.efectivo_en", aparte.Key)</dt><dd>@Fmt.Money(aparte.Value, aparte.Key)</dd>
                    }
                </dl>
            }
            else
            {
                <div class="alert info"><Icon Name="eye-off" Size="18" /><span>@T("cashsessions.cierre_ciego_explica")</span></div>
            }
            @if (_denominations.Count > 0)
            {
                <div class="segmented">
                    <button class="@(_byDenomination ? "" : "on")" @onclick="() => _byDenomination = false">@T("cashsessions.por_total")</button>
                    <button class="@(_byDenomination ? "on" : "")" @onclick="() => _byDenomination = true">@T("cashsessions.por_billetes_y_monedas")</button>
                </div>
            }
            @if (_byDenomination)
            {
                <div class="denoms">
                    @foreach (var d in _denominations)
                    {
                        var value = d;
                        <label class="denom">
                            <span>@Fmt.Money(value, Currency)</span>
                            <input class="control" type="number" min="0" step="1" value="@(_counts.TryGetValue(value, out var q) && q > 0 ? q.ToString() : "")"
                                   @oninput="e => _counts[value] = int.TryParse(e.Value?.ToString(), out var n) && n > 0 ? n : 0" />
                        </label>
                    }
                </div>
            }
            else
            {
                <div class="field">
                    <label>@T("cashsessions.efectivo_contado", Fmt.Symbol(Currency))</label>
                    <input class="control" type="number" min="0" step="0.10" @bind="_amount" @bind:event="oninput" />
                </div>
            }
            <dl class="totals">
                <dt>@T("cashsessions.efectivo_contado_2")</dt><dd>@Fmt.Money(Counted, Currency)</dd>
                @if (!_store.BlindClose)
                {
                    <dt class="grand">@T("cashsessions.diferencia")</dt>
                    <dd class="grand @(Counted - cs.ExpectedCash == 0 ? "good-text" : "warn-text")">@(Counted - cs.ExpectedCash > 0 ? "+" : "")@Fmt.Money(Counted - cs.ExpectedCash, Currency)</dd>
                }
            </dl>
            <div class="field">
                <label>@T("cashsessions.observacion_opcional")</label>
                <input class="control" placeholder="@(T("cashsessions.explica_la_diferencia_si_la"))" @bind="_note" />
            </div>
        </ChildContent>
        <Footer>
            <button class="btn" @onclick="() => _closing = false">@T("cashsessions.cancelar")</button>
            <button class="btn btn-dark" disabled="@_busy" @onclick="CloseAsync">@T("cashsessions.cerrar_caja")</button>
        </Footer>
    </Modal>
}

@if (_report is { } report)
{
    <Modal Title="@(report.IsFinal ? T("cashsessions.reporte_z") : T("cashsessions.reporte_x"))" Subtitle="@report.Session.Number" OnClose="() => _report = null">
        <ChildContent>
            <pre class="ticket-preview">@_reportTicket?.ToText()</pre>
        </ChildContent>
        <Footer>
            <button class="btn" @onclick="() => _report = null">@T("cashsessions.cerrar")</button>
            <button class="btn btn-dark" disabled="@(!Printer.IsConfigured)" title="@(Printer.IsConfigured ? null : T("printer.no_hay_impresora"))" @onclick="PrintReportAsync">
                <Icon Name="receipt" Size="18" />@T("cashsessions.imprimir")
            </button>
        </Footer>
    </Modal>
}

@code {
    [SupplyParameterFromQuery(Name = "abrir")] public int? OpenQuery { get; set; }

    private CashSessionRow? _open;
    private CashSummary? _summary;
    private IReadOnlyList<CashMovementRow> _movements = [];
    private PagedResult<CashSessionRow>? _history;
    private StoreSettings _store = StoreSettings.Default;
    private string Currency = "PEN";
    private string? _storeName;
    private int _page = 1;
    private bool _opening, _closing, _busy, _byDenomination;
    private string? _movementKind;
    private decimal _amount;
    private string? _note, _error, _bank, _reference;
    private IReadOnlyList<decimal> _denominations = [];
    private readonly Dictionary<decimal, int> _counts = [];
    private CashReport? _report;
    private TicketDocument? _reportTicket;

    /// <summary>Con cierre ciego, solo quien puede ver el reporte X ve el efectivo esperado.</summary>
    private bool ShowExpected => !_store.BlindClose || Session.Can(PosPermissions.CashReport);

    private decimal Counted => _byDenomination ? _counts.Sum(c => c.Key * c.Value) : _amount;

    protected override async Task LoadAsync()
    {
        _open = await Pos.Cash.GetOpenAsync();
        _summary = _open is null ? null : await Pos.Cash.GetSummaryAsync(_open.Id);
        _movements = _open is null ? [] : await Pos.Cash.GetMovementsAsync(_open.Id);
        _history = await Pos.Cash.GetSessionsAsync(_page, 10);
        Currency = (await Pos.Master.GetCompanyAsync())?.CurrencyCode ?? "PEN";
        _denominations = Denominations.For(Currency);
        _store = await Pos.Stores.GetCurrentAsync();
        var sites = (await Pos.Master.GetSitesAsync(activeOnly: true)).Where(s => Session.SiteIds.Count == 0 || Session.SiteIds.Contains(s.Id)).ToList();
        _storeName = (sites.FirstOrDefault(s => s.Id == Session.DefaultSiteId) ?? sites.FirstOrDefault(s => s.Kind == "Store") ?? sites.FirstOrDefault())?.Name;
        if (OpenQuery == 1 && _open is null && !_opening)
        {
            OpenQuery = null;
            StartOpen();
        }
    }

    private void StartOpen()
    {
        _error = null;
        _amount = 0;
        _opening = true;
    }

    private void StartClose()
    {
        _error = null;
        _note = null;
        _counts.Clear();
        _byDenomination = false;
        _amount = _store.BlindClose ? 0 : _summary?.ExpectedCash ?? 0;
        _closing = true;
    }

    private void StartMovement(string kind)
    {
        _error = null;
        _amount = 0;
        (_note, _bank, _reference) = (null, null, null);
        _movementKind = kind;
    }

    private async Task OpenAsync()
    {
        _busy = true;
        _error = await TryAsync(() => Pos.Cash.OpenAsync(_amount), T("cashsessions.caja_abierta_buenas_ventas"));
        _busy = false;
        if (_error is null)
            _opening = false;
    }

    private async Task AddMovementAsync()
    {
        if (_movementKind is not { } kind)
            return;
        _busy = true;
        _error = await TryAsync(() => Pos.Cash.AddMovementAsync(kind, _amount,
                string.IsNullOrWhiteSpace(_note) && kind == CashMovementKinds.Deposit ? T("cashsessions.deposito_en_banco") : _note ?? "", _reference, _bank),
            kind == CashMovementKinds.In ? T("cashsessions.ingreso_registrado") : kind == CashMovementKinds.Deposit ? T("cashsessions.deposito_registrado") : T("cashsessions.retiro_registrado"));
        _busy = false;
        if (_error is not null)
            return;
        _movementKind = null;
        if (Printer.IsConfigured && _store.OpenDrawerOnCash)
            await Printer.OpenDrawerAsync();
    }

    private async Task OpenDrawerAsync()
    {
        if (await Printer.OpenDrawerAsync() is { } error)
            Toasts.Error(error);
    }

    private async Task CloseAsync()
    {
        if (_open is not { } s)
            return;
        _busy = true;
        decimal diff = 0;
        var counts = _counts.Where(c => c.Value > 0).Select(c => new DenominationCount(c.Key, c.Value)).ToList();
        _error = await TryAsync(async () => diff = _byDenomination
            ? await Pos.Cash.CloseAsync(s.Id, counts, _note)
            : await Pos.Cash.CloseAsync(s.Id, _amount, _note));
        _busy = false;
        if (_error is not null)
            return;
        _closing = false;
        Toasts.Success(diff == 0 ? T("cashsessions.caja_cerrada_sin_diferencias") : T("cashsessions.caja_cerrada_con_una_diferencia", (Fmt.Money(diff, Currency))));
        if (Session.Can(PosPermissions.CashReport))
            await ShowReportAsync(s.Id);
    }

    private async Task ShowReportAsync(Guid sessionId)
    {
        if (await TryAsync(async () => _report = await Pos.Cash.GetReportAsync(sessionId)) is { } error)
        {
            Toasts.Error(error);
            return;
        }
        var settings = await Pos.Stores.GetAsync(_report!.Session.SiteId);
        _reportTicket = TicketBuilder.ForCashReport(_report, await Pos.Master.GetCompanyAsync(), settings, Fmt.Culture);
    }

    private async Task PrintReportAsync()
    {
        if (_reportTicket is { } ticket && await Printer.PrintAsync(ticket) is { } error)
            Toasts.Error(error);
    }
}
