@page "/turnos"
@inherits PosPage

<SectionContent SectionName="page-title">@T("cashsessions.turnos_de_caja")</SectionContent>

<div class="page">
    <div class="page-head">
        <div>
            <h2>@T("cashsessions.turnos_de_caja")</h2>
            <p>@T("cashsessions.abre_la_caja_con_el")</p>
        </div>
        @if (_open is null && !Loading)
        {
            <button class="btn btn-dark" @onclick="StartOpen"><Icon Name="unlock" Size="18" />@T("cashsessions.abrir_caja")</button>
        }
    </div>

    @if (_open is { } s && _summary is { } sum)
    {
        <div class="card">
            <div class="card-head">
                <div>
                    <h3>@T("cashsessions.caja_abierta", s.Number)</h3>
                    <div class="sub">@T("cashsessions.desde_el", s.SiteName, Fmt.DateTime(s.OpenedAt), (s.OpenedBy is null ? "" : T("cashsessions.por", s.OpenedBy)))</div>
                </div>
                <div style="display:flex;gap:8px">
                    <a class="btn btn-sm" href="caja"><Icon Name="cart" Size="16" />@T("cashsessions.vender")</a>
                    @if (Session.Can(PosPermissions.CloseCash))
                    {
                        <button class="btn btn-dark btn-sm" @onclick="StartClose"><Icon Name="lock" Size="16" />@T("cashsessions.cerrar_caja")</button>
                    }
                </div>
            </div>
            <div class="stat-strip boxed" style="margin:0 20px 18px">
                <StatTile Icon="receipt" Label="@(T("cashsessions.ventas_del_turno"))" Value="@Fmt.Compact(sum.Sales)" Hint="@Fmt.Money(sum.SalesTotal, Currency)" />
                <StatTile Icon="cash" Label="@(T("cashsessions.fondo_inicial"))" Value="@Fmt.Money(sum.OpeningFloat, Currency)" />
                <StatTile Icon="cash" Label="@(T("cashsessions.cobrado_en_efectivo"))" Value="@Fmt.Money(sum.CashSales, Currency)" Hint="@(sum.CashRefunds > 0 ? T("cashsessions.en_devoluciones", (Fmt.Money(sum.CashRefunds, Currency))) : null)" />
                <StatTile Icon="wallet" Label="@(T("cashsessions.efectivo_esperado"))" Value="@Fmt.Money(sum.ExpectedCash, Currency)" />
            </div>
            @if (sum.ByMethod.Count > 0)
            {
                <div class="card-body">
                    @foreach (var (method, amount) in sum.ByMethod.OrderByDescending(m => m.Value))
                    {
                        <div class="list-row">
                            <Icon Name="@Fmt.PaymentIcon(method)" Size="18" Class="faint" />
                            <span>@Fmt.PaymentMethod(method)</span>
                            <strong class="end">@Fmt.Money(amount, Currency)</strong>
                        </div>
                    }
                </div>
            }
        </div>
    }
    else if (!Loading)
    {
        <div class="alert info"><Icon Name="lock" Size="18" /><span>@T("cashsessions.la_caja_de_este_equipo")</span></div>
    }

    <div class="card">
        <div class="card-head"><h3>@T("cashsessions.historial_de_turnos")</h3></div>
        <div class="card-body" style="padding-top:0">
            @if (_history is { Total: 0 })
            {
                <EmptyState Icon="clock" Title="@(T("cashsessions.aun_no_hay_turnos"))" Text="@(T("cashsessions.cada_apertura_cierre_de_esta"))" />
            }
            else if (_history is { } h)
            {
                <div class="table-wrap">
                    <table class="data">
                        <thead>
                            <tr><th>@T("cashsessions.turno")</th><th>@T("cashsessions.apertura")</th><th>@T("cashsessions.cierre")</th><th class="num">@T("cashsessions.ventas")</th><th class="num">@T("cashsessions.esperado")</th><th class="num">@T("cashsessions.contado")</th><th class="num">@T("cashsessions.diferencia")</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var t in h.Items)
                            {
                                <tr @key="t.Id">
                                    <td><div class="two-line"><span class="t1">@t.Number</span><span class="t2">@t.SiteName</span></div></td>
                                    <td><div class="two-line"><span class="t1" style="font-weight:600">@Fmt.DateTime(t.OpenedAt)</span><span class="t2">@t.OpenedBy</span></div></td>
                                    <td>
                                        @if (t.ClosedAt is { } closed)
                                        {
                                            <div class="two-line"><span class="t1" style="font-weight:600">@Fmt.DateTime(closed)</span><span class="t2">@t.ClosedBy</span></div>
                                        }
                                        else
                                        {
                                            <StatusPill Text="@(T("cashsessions.abierta"))" Tone="good" />
                                        }
                                    </td>
                                    <td class="num">@Fmt.Money(t.SalesTotal, Currency)<div class="muted" style="font-size:12px">@Fmt.Count(t.Sales, T("count.venta"), T("count.ventas"))</div></td>
                                    <td class="num">@(t.ExpectedCash is { } e ? Fmt.Money(e, Currency) : "—")</td>
                                    <td class="num">@(t.CountedCash is { } c ? Fmt.Money(c, Currency) : "—")</td>
                                    <td class="num">
                                        @if (t.Difference is { } diff)
                                        {
                                            <span class="@(diff == 0 ? "qty-pos" : "qty-neg")" title="@t.Note">@(diff > 0 ? "+" : "")@Fmt.Money(diff, Currency)</span>
                                        }
                                        else
                                        {
                                            <span class="faint">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <Pager Page="h.Page" PageSize="h.PageSize" Total="h.Total" Noun="@(T("cashsessions.turnos"))" OnPage="async p => { _page = p; await ReloadAsync(); }" />
            }
        </div>
    </div>
</div>

@if (_opening)
{
    <Modal Title="@(T("cashsessions.abrir_caja"))" Subtitle="@(_storeName is null ? T("cashsessions.elige_primero_la_tienda_de") : T("cashsessions.tienda", _storeName))" Size="sm" Error="@_error" OnClose="() => _opening = false">
        <ChildContent>
            <div class="field">
                <label>@T("cashsessions.fondo_inicial_en_efectivo", Fmt.Symbol(Currency))</label>
                <input class="control" type="number" min="0" step="0.10" @bind="_amount" />
            </div>
        </ChildContent>
        <Footer>
            <button class="btn" @onclick="() => _opening = false">@T("cashsessions.cancelar")</button>
            <button class="btn btn-dark" disabled="@_busy" @onclick="OpenAsync">@T("cashsessions.abrir_caja")</button>
        </Footer>
    </Modal>
}

@if (_closing && _summary is { } cs)
{
    <Modal Title="@(T("cashsessions.cerrar_caja"))" Subtitle="@(T("cashsessions.cuenta_el_efectivo_del_cajon"))" Size="sm" Error="@_error" OnClose="() => _closing = false">
        <ChildContent>
            <dl class="totals">
                <dt>@T("cashsessions.efectivo_esperado")</dt><dd>@Fmt.Money(cs.ExpectedCash, Currency)</dd>
            </dl>
            <div class="field">
                <label>@T("cashsessions.efectivo_contado", Fmt.Symbol(Currency))</label>
                <input class="control" type="number" min="0" step="0.10" @bind="_amount" @bind:event="oninput" />
            </div>
            <dl class="totals">
                <dt class="grand">@T("cashsessions.diferencia")</dt>
                <dd class="grand @(_amount - cs.ExpectedCash == 0 ? "good-text" : "warn-text")">@(_amount - cs.ExpectedCash > 0 ? "+" : "")@Fmt.Money(_amount - cs.ExpectedCash, Currency)</dd>
            </dl>
            <div class="field">
                <label>@T("cashsessions.observacion_opcional")</label>
                <input class="control" placeholder="@(T("cashsessions.explica_la_diferencia_si_la"))" @bind="_note" />
            </div>
        </ChildContent>
        <Footer>
            <button class="btn" @onclick="() => _closing = false">@T("cashsessions.cancelar")</button>
            <button class="btn btn-dark" disabled="@_busy" @onclick="CloseAsync">@T("cashsessions.cerrar_caja")</button>
        </Footer>
    </Modal>
}

@code {
    [SupplyParameterFromQuery(Name = "abrir")] public int? OpenQuery { get; set; }

    private CashSessionRow? _open;
    private CashSummary? _summary;
    private PagedResult<CashSessionRow>? _history;
    private string Currency = "PEN";
    private string? _storeName;
    private int _page = 1;
    private bool _opening, _closing, _busy;
    private decimal _amount;
    private string? _note, _error;

    protected override async Task LoadAsync()
    {
        _open = await Pos.Cash.GetOpenAsync();
        _summary = _open is null ? null : await Pos.Cash.GetSummaryAsync(_open.Id);
        _history = await Pos.Cash.GetSessionsAsync(_page, 10);
        Currency = (await Pos.Master.GetCompanyAsync())?.CurrencyCode ?? "PEN";
        var sites = await Pos.Master.GetSitesAsync(activeOnly: true);
        _storeName = (sites.FirstOrDefault(s => s.Id == Session.DefaultSiteId) ?? sites.FirstOrDefault(s => s.Kind == "Store"))?.Name;
        if (OpenQuery == 1 && _open is null && !_opening)
        {
            OpenQuery = null;
            StartOpen();
        }
    }

    private void StartOpen()
    {
        _error = null;
        _amount = 0;
        _opening = true;
    }

    private void StartClose()
    {
        _error = null;
        _note = null;
        _amount = _summary?.ExpectedCash ?? 0;
        _closing = true;
    }

    private async Task OpenAsync()
    {
        _busy = true;
        _error = await TryAsync(() => Pos.Cash.OpenAsync(_amount), T("cashsessions.caja_abierta_buenas_ventas"));
        _busy = false;
        if (_error is null)
            _opening = false;
    }

    private async Task CloseAsync()
    {
        if (_open is not { } s)
            return;
        _busy = true;
        decimal diff = 0;
        _error = await TryAsync(async () => diff = await Pos.Cash.CloseAsync(s.Id, _amount, _note));
        _busy = false;
        if (_error is null)
        {
            _closing = false;
            Toasts.Success(diff == 0 ? T("cashsessions.caja_cerrada_sin_diferencias") : T("cashsessions.caja_cerrada_con_una_diferencia", (Fmt.Money(diff, Currency))));
        }
    }
}
