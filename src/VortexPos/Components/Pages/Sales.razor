@page "/ventas"
@inherits PosPage
@inject FileExporter Exporter

<SectionContent SectionName="page-title">@T("sales.ventas_2")</SectionContent>

<div class="page">
    <div class="page-head">
        <div>
            <h2>@T("sales.ventas_2")</h2>
            <p>@T("sales.las_de_esta_caja_las")</p>
        </div>
        <div style="display:flex;gap:10px;flex-wrap:wrap">
            <button class="btn btn-outline" @onclick="ExportAsync"><Icon Name="download" Size="18" />@T("sales.exportar_csv")</button>
            <a class="btn btn-dark" href="caja"><Icon Name="cart" Size="18" />@T("sales.nueva_venta")</a>
        </div>
    </div>

    <div class="filters">
        <div class="field search">
            <label>@T("sales.buscar")</label>
            <div class="input-icon">
                <Icon Name="search" Size="16" />
                <input class="control" placeholder="@(T("sales.numero_cliente_comprobante"))" value="@_search" @oninput="OnSearchInput" />
            </div>
        </div>
        <div class="field">
            <label>@T("sales.desde")</label>
            <input class="control" type="date" value="@_from?.ToString("yyyy-MM-dd")" @onchange="async e => { _from = ParseDate(e.Value); _page = 1; await ReloadAsync(); }" />
        </div>
        <div class="field">
            <label>@T("sales.hasta")</label>
            <input class="control" type="date" value="@_to?.ToString("yyyy-MM-dd")" @onchange="async e => { _to = ParseDate(e.Value); _page = 1; await ReloadAsync(); }" />
        </div>
        <div class="field">
            <label>@T("sales.tienda")</label>
            <select class="select" value="@_site" @onchange="async e => { _site = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null; _page = 1; await ReloadAsync(); }">
                <option value="">@T("sales.todas")</option>
                @foreach (var site in _sites)
                {
                    <option value="@site.Id">@site.Name</option>
                }
            </select>
        </div>
        <div class="field" style="width:auto">
            <label>@T("sales.estado")</label>
            <div class="segmented">
                @foreach (var (value, label) in Tabs)
                {
                    <button class="@(_status == value ? "on" : "")" @onclick="async () => { _status = value; _page = 1; await ReloadAsync(); }">@label</button>
                }
            </div>
        </div>
    </div>

    @if (_result is { } page)
    {
        @if (page.Total == 0 && !Loading)
        {
            <EmptyState Icon="receipt" Title="@(T("sales.no_hay_ventas"))" Text="@(T("sales.las_ventas_que_registres_en"))" />
        }
        else
        {
            <div class="table-wrap">
                <table class="data">
                    <thead>
                        <tr>
                            <th>@T("sales.venta_2")</th>
                            <th>@T("sales.cliente")</th>
                            <th>@T("sales.tienda")</th>
                            <th class="num">@T("sales.total")</th>
                            <th>@T("sales.estado")</th>
                            <th class="actions-col">@T("sales.acciones")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in page.Items)
                        {
                            var (text, tone) = StatusPill.ForSale(s);
                            <tr @key="s.Id" style="cursor:pointer" @onclick="() => OpenAsync(s)">
                                <td>
                                    <div class="two-line">
                                        <span class="t1">@s.Number</span>
                                        <span class="t2">@Fmt.DateTime(s.CreatedAt)@(s.UserName is null ? "" : $" · {s.UserName}")@(s.Origin == "remote" ? T("sales.otra_caja") : "")</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="two-line">
                                        <span class="t1" style="font-weight:600">@(s.CustomerName ?? T("sales.clientes_varios"))</span>
                                        <span class="t2">@(s.InvoiceNumber is { } inv ? T("sales.comprobante_n", inv) : T("sales.n_articulos", Fmt.Qty(s.Items)))</span>
                                    </div>
                                </td>
                                <td><span class="muted">@s.SiteName</span></td>
                                <td class="num strong">@Fmt.Money(s.Total, s.CurrencyCode)</td>
                                <td><StatusPill Text="@text" Tone="@tone" /></td>
                                <td class="actions-col" @onclick:stopPropagation>
                                    <KebabMenu>
                                        <button @onclick="() => OpenAsync(s)"><Icon Name="receipt" Size="18" />@T("sales.ver_detalle")</button>
                                        @if (s.CanReturn && Session.Can(PosPermissions.Return))
                                        {
                                            <button @onclick="() => StartReturnAsync(s)"><Icon Name="undo" Size="18" />@T("sales.registrar_devolucion")</button>
                                        }
                                        @if (s.CanVoid && Session.Can(PosPermissions.Void))
                                        {
                                            <button class="danger" @onclick="() => StartVoid(s)"><Icon Name="ban" Size="18" />@T("sales.anular_2")</button>
                                        }
                                    </KebabMenu>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <Pager Page="page.Page" PageSize="page.PageSize" Total="page.Total" Noun="@(T("sales.ventas"))" OnPage="async p => { _page = p; await ReloadAsync(); }" />
        }
    }
</div>

@if (_detail is { } d)
{
    <Modal Title="@(T("sales.venta", d.Number))" Subtitle="@($"{Fmt.DateTime(d.CreatedAt)} · {d.SiteName}")" Size="lg" OnClose="() => _detail = null">
        <ChildContent>
            @{ var (text, tone) = StatusPill.ForSale(d); }
            <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
                <StatusPill Text="@text" Tone="@tone" />
                <span class="muted">@(d.CustomerName ?? T("sales.clientes_varios"))@(d.UserName is null ? "" : T("sales.atendio", d.UserName))</span>
            </div>
            @if (d.VoidReason is not null)
            {
                <div class="alert warn"><Icon Name="ban" Size="18" /><span>@T("sales.anulada_el", Fmt.DateTime(d.VoidedAt!.Value), d.VoidReason)</span></div>
            }
            <div class="table-wrap">
                <table class="data" style="min-width:480px">
                    <thead><tr><th>@T("sales.articulo")</th><th class="num">@T("sales.cant")</th><th class="num">@T("sales.precio")</th><th class="num">@T("sales.importe")</th></tr></thead>
                    <tbody>
                        @foreach (var l in _lines)
                        {
                            <tr>
                                <td>
                                    <div class="two-line">
                                        <span class="t1">@l.Name</span>
                                        <span class="t2">#@l.Sku@(l.Discount > 0 ? T("sales.desc", (Fmt.Money(l.Discount, d.CurrencyCode))) : "")@(l.ReturnedQty > 0 ? T("sales.devuelto", Fmt.Qty(l.ReturnedQty)) : "")</span>
                                    </div>
                                </td>
                                <td class="num">@Fmt.Qty(l.Quantity)</td>
                                <td class="num">@Fmt.Money(l.UnitPrice, d.CurrencyCode)</td>
                                <td class="num strong">@Fmt.Money(l.Total, d.CurrencyCode)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="grid-2" style="grid-template-columns:1fr 1fr">
                <dl class="kv">
                    @foreach (var p in _payments)
                    {
                        <dt>@Fmt.PaymentMethod(p.Method)@(p.Reference is null ? "" : $" ({p.Reference})")</dt>
                        <dd>@Fmt.Money(p.Amount, d.CurrencyCode)</dd>
                    }
                    @if (d.CashReceived is { } received)
                    {
                        <dt>@T("sales.efectivo_recibido")</dt><dd>@Fmt.Money(received, d.CurrencyCode)</dd>
                        <dt>@T("sales.vuelto")</dt><dd>@Fmt.Money(d.ChangeGiven ?? 0, d.CurrencyCode)</dd>
                    }
                    @if (d.InvoiceNumber is not null)
                    {
                        <dt>@T("sales.comprobante_erp")</dt><dd>@d.InvoiceNumber</dd>
                    }
                </dl>
                <dl class="totals">
                    <dt>@T("sales.subtotal")</dt><dd>@Fmt.Money(d.Subtotal, d.CurrencyCode)</dd>
                    <dt>@T("sales.impuesto")</dt><dd>@Fmt.Money(d.Tax, d.CurrencyCode)</dd>
                    @if (d.Discount > 0)
                    {
                        <dt>@T("sales.descuentos")</dt><dd>−@Fmt.Money(d.Discount, d.CurrencyCode)</dd>
                    }
                    <dt class="grand">@T("sales.total")</dt><dd class="grand">@Fmt.Money(d.Total, d.CurrencyCode)</dd>
                    @if (d.Returned > 0)
                    {
                        <dt>@T("sales.devuelto_2")</dt><dd class="warn-text">−@Fmt.Money(d.Returned, d.CurrencyCode)</dd>
                    }
                </dl>
            </div>
        </ChildContent>
        <Footer>
            @if (d.CanVoid && Session.Can(PosPermissions.Void))
            {
                <button class="btn btn-danger" @onclick="() => StartVoid(d)"><Icon Name="ban" Size="18" />@T("sales.anular_2")</button>
            }
            @if (d.CanReturn && Session.Can(PosPermissions.Return))
            {
                <button class="btn" @onclick="() => StartReturnAsync(d)"><Icon Name="undo" Size="18" />@T("sales.devolucion")</button>
            }
            <button class="btn btn-dark" @onclick="() => _detail = null">@T("sales.cerrar")</button>
        </Footer>
    </Modal>
}

@if (_voiding is { } v)
{
    <Modal Title="@(T("sales.anular", v.Number))" Subtitle="@(T("sales.el_wms_devolvera_el_stock"))" Size="sm" Error="@_error" OnClose="() => _voiding = null">
        <ChildContent>
            <div class="field">
                <label>@T("sales.motivo")</label>
                <input class="control" placeholder="@(T("sales.error_de_cobro_venta_duplicada"))" @bind="_reason" />
            </div>
        </ChildContent>
        <Footer>
            <button class="btn" @onclick="() => _voiding = null">@T("sales.cancelar")</button>
            <button class="btn btn-danger" disabled="@_busy" @onclick="VoidAsync">@T("sales.anular_venta")</button>
        </Footer>
    </Modal>
}

@if (_returning is { } rt)
{
    <Modal Title="@(T("sales.devolucion_de", rt.Number))" Subtitle="@(T("sales.el_reembolso_sale_en_efectivo"))" Error="@_error" OnClose="() => _returning = null">
        <ChildContent>
            @foreach (var line in _returnLines.Where(l => l.Line.Returnable > 0))
            {
                <div class="list-row">
                    <div class="two-line" style="flex:1">
                        <span class="t1">@line.Line.Name</span>
                        <span class="t2">@T("sales.vendido_se_puede_devolver", Fmt.Qty(line.Line.Quantity), Fmt.Qty(line.Line.Returnable))</span>
                    </div>
                    <input class="control" style="width:110px" type="number" min="0" max="@line.Line.Returnable" step="any" @bind="line.Quantity" @bind:event="oninput" aria-label="@(T("sales.cantidad_devolver"))" />
                </div>
            }
            <div class="field">
                <label>@T("sales.motivo")</label>
                <input class="control" placeholder="@(T("sales.producto_danado_cambio"))" @bind="_reason" />
            </div>
            <dl class="totals">
                <dt class="grand">@T("sales.devolver")</dt><dd class="grand">@Fmt.Money(ReturnTotal, rt.CurrencyCode)</dd>
            </dl>
        </ChildContent>
        <Footer>
            <button class="btn" @onclick="() => _returning = null">@T("sales.cancelar")</button>
            <button class="btn btn-dark" disabled="@(_busy || ReturnTotal <= 0)" @onclick="ReturnAsync">@T("sales.registrar_devolucion")</button>
        </Footer>
    </Modal>
}

@code {
    private sealed class ReturnDraft
    {
        public required SaleLineRow Line { get; init; }
        public decimal Quantity { get; set; }
    }

    private static (string Value, string Label)[] Tabs => [("", T("sales.todas")), (SaleStatuses.Completed, T("sales.pagadas")), (SaleStatuses.Voided, T("sales.anuladas"))];

    private const int PageSize = 15;
    private PagedResult<SaleRow>? _result;
    private IReadOnlyList<SiteRow> _sites = [];
    private string _search = "", _status = "";
    private DateOnly? _from, _to;
    private Guid? _site;
    private int _page = 1;
    private CancellationTokenSource? _debounce;

    private SaleRow? _detail, _voiding, _returning;
    private IReadOnlyList<SaleLineRow> _lines = [];
    private IReadOnlyList<PaymentRow> _payments = [];
    private List<ReturnDraft> _returnLines = [];
    private string _reason = "";
    private string? _error;
    private bool _busy;

    private decimal ReturnTotal => _returnLines.Where(l => l.Quantity > 0 && l.Quantity <= l.Line.Returnable)
        .Sum(l => VortexApi.Suite.Money.Currencies.Get(_returning?.CurrencyCode).Round(l.Line.Total * l.Quantity / l.Line.Quantity));

    [SupplyParameterFromQuery(Name = "q")] public string? Query { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (Query is not null && Query != _search)
        {
            _search = Query;
            _page = 1;
            await ReloadAsync();
        }
    }

    protected override async Task LoadAsync()
    {
        _sites = await Pos.Master.GetSitesAsync();
        _result = await Pos.Sales.GetSalesAsync(BuildQuery(_page));
        if (_detail is { } open)
            _detail = await Pos.Sales.GetSaleAsync(open.Id);
    }

    private SaleQuery BuildQuery(int page, int pageSize = PageSize) =>
        new(_search, _site, _status == "" ? null : _status, _from, _to, page, pageSize);

    private static DateOnly? ParseDate(object? value) => DateOnly.TryParse(value?.ToString(), out var d) ? d : null;

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        _debounce?.Cancel();
        _debounce = new CancellationTokenSource();
        try
        {
            await Task.Delay(220, _debounce.Token);
            _page = 1;
            await ReloadAsync();
        }
        catch (TaskCanceledException)
        {
        }
    }

    private async Task OpenAsync(SaleRow sale)
    {
        _lines = await Pos.Sales.GetLinesAsync(sale.Id);
        _payments = await Pos.Sales.GetPaymentsAsync(sale.Id);
        _detail = sale;
    }

    private void StartVoid(SaleRow sale)
    {
        _error = null;
        _reason = "";
        _voiding = sale;
    }

    private async Task VoidAsync()
    {
        if (_voiding is not { } sale)
            return;
        _busy = true;
        _error = await TryAsync(() => Pos.Sales.VoidAsync(sale.Id, _reason), T("sales.venta_anulada", sale.Number));
        _busy = false;
        if (_error is null)
        {
            _voiding = null;
            _detail = null;
        }
    }

    private async Task StartReturnAsync(SaleRow sale)
    {
        _error = null;
        _reason = "";
        _returnLines = (await Pos.Sales.GetLinesAsync(sale.Id)).Select(l => new ReturnDraft { Line = l }).ToList();
        _detail = null;
        _returning = sale;
    }

    private async Task ReturnAsync()
    {
        if (_returning is not { } sale)
            return;
        var lines = _returnLines.Where(l => l.Quantity > 0).Select(l => new ReturnLine(l.Line.LineNo, l.Quantity)).ToList();
        _busy = true;
        string? number = null;
        _error = await TryAsync(async () => number = await Pos.Sales.ReturnAsync(sale.Id, lines, _reason));
        _busy = false;
        if (_error is null)
        {
            Toasts.Success(T("sales.devolucion_registrada_entrega_en_efectivo", number, (Fmt.Money(ReturnTotal, sale.CurrencyCode))));
            _returning = null;
        }
    }

    private async Task ExportAsync()
    {
        var all = await Pos.Sales.GetSalesAsync(BuildQuery(1, 100_000));
        var csv = new System.Text.StringBuilder(T("sales.numero_fecha_tienda_cliente_estado"));
        foreach (var s in all.Items)
        {
            csv.AppendLine(string.Join(';', s.Number, s.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm"), s.SiteName, s.CustomerName,
                Fmt.SaleStatus(s.Status), Csv(s.Subtotal), Csv(s.Tax), Csv(s.Total), Csv(s.Returned), s.InvoiceNumber));
        }
        var path = await Exporter.ExportAsync($"ventas-{DateTime.Now:yyyyMMdd-HHmm}.csv", csv.ToString());
        Toasts.Success(T("sales.exportadas_ventas", all.Total, Path.GetFileName(path)));
    }

    private static string Csv(decimal value) => value.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);

    public override void Dispose()
    {
        _debounce?.Cancel();
        base.Dispose();
    }
}
