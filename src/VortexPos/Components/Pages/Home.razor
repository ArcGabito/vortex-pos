@page "/"
@inherits PosPage

<SectionContent SectionName="page-title">@T("home.panel")</SectionContent>

@if (_summary is { } s)
{
    <div class="stat-strip">
        <StatTile Icon="wallet" Label="@(T("home.vendido_hoy"))" Value="@Fmt.MoneyCompact(s.SalesToday, s.CurrencyCode)" Delta="s.SalesChangePct" Hint="@(s.SalesChangePct is null ? null : T("home.vs_ayer_esta_hora"))" />
        <StatTile Icon="receipt" Label="@(T("home.tickets_hoy"))" Value="@Fmt.Compact(s.TicketsToday)" Hint="@(T("home.promedio", (Fmt.Money(s.AverageTicket, s.CurrencyCode))))" />
        <StatTile Icon="arrows" Label="@(T("home.ultimos_7_dias"))" Value="@Fmt.MoneyCompact(s.Sales7d, s.CurrencyCode)" />
        <StatTile Icon="ban" Label="@(T("home.anuladas"))" Value="@Fmt.Compact(s.Voided7d)" UpIsGood="false" Hint="@(T("home.ultimos_7_dias_2"))" />
    </div>
}

<div class="page">
    <div class="page-head">
        <div>
            <h2>@T("home.hola", FirstName)</h2>
            <p>@Session.Session?.Access.OrganizationName · @(_cash is { } c ? T("home.caja_abierta_en_desde_las", c.SiteName, c.OpenedAt.ToLocalTime()) : T("home.la_caja_esta_cerrada"))</p>
        </div>
        <div style="display:flex;gap:10px;flex-wrap:wrap">
            @if (_cash is null)
            {
                <a class="btn btn-outline" href="turnos?abrir=1"><Icon Name="unlock" Size="18" />@T("home.abrir_caja")</a>
            }
            <a class="btn btn-dark" href="caja"><Icon Name="cart" Size="18" />@T("home.vender")</a>
        </div>
    </div>

    <div class="grid-2">
        <div class="card">
            <div class="card-head">
                <div>
                    <h3>@T("home.ventas_recientes")</h3>
                    <div class="sub">@T("home.las_ultimas_de_todas_las")</div>
                </div>
                <a class="btn btn-sm" href="ventas">@T("home.ver_todas")</a>
            </div>
            <div class="card-body" style="padding-top:12px">
                @if (_recent.Count == 0)
                {
                    <EmptyState Icon="receipt" Title="@(T("home.aun_no_hay_ventas"))" Text="@(T("home.abre_la_caja_registra_tu"))" />
                }
                else
                {
                    <div class="table-wrap">
                        <table class="data" style="min-width:520px">
                            <thead><tr><th>@T("home.venta")</th><th>@T("home.cliente")</th><th>@T("home.estado")</th><th class="num">@T("home.total")</th><th class="num">@T("home.cuando")</th></tr></thead>
                            <tbody>
                                @foreach (var r in _recent)
                                {
                                    var (text, tone) = StatusPill.ForSale(r);
                                    <tr>
                                        <td><div class="two-line"><span class="t1">@r.Number</span><span class="t2">@r.SiteName</span></div></td>
                                        <td><span class="muted">@(r.CustomerName ?? T("home.clientes_varios"))</span></td>
                                        <td><StatusPill Text="@text" Tone="@tone" /></td>
                                        <td class="num strong">@Fmt.Money(r.Total, r.CurrencyCode)</td>
                                        <td class="num muted">@Fmt.Ago(r.CreatedAt)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <div style="display:flex;flex-direction:column;gap:20px;min-width:0">
            <div class="card">
                <div class="card-head">
                    <div>
                        <h3>@T("home.cobrado_hoy")</h3>
                        <div class="sub">@T("home.por_medio_de_pago")</div>
                    </div>
                </div>
                <div class="card-body">
                    @if (_summary is not { ByMethodToday.Count: > 0 } sum)
                    {
                        <div class="list-row"><span class="muted">@T("home.sin_cobros_hoy")</span></div>
                    }
                    else
                    {
                        var max = sum.ByMethodToday.Values.Max();
                        @foreach (var (method, amount) in sum.ByMethodToday)
                        {
                            <div class="list-row" style="flex-wrap:wrap">
                                <Icon Name="@Fmt.PaymentIcon(method)" Size="18" Class="faint" />
                                <span>@Fmt.PaymentMethod(method)</span>
                                <strong class="end">@Fmt.Money(amount, sum.CurrencyCode)</strong>
                                <div class="bar"><span style="width:@((int)(amount / max * 100))%"></span></div>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="card">
                <div class="card-head">
                    <div>
                        <h3>@T("home.lo_mas_vendido")</h3>
                        <div class="sub">@T("home.ultimos_7_dias")</div>
                    </div>
                </div>
                <div class="card-body">
                    @if (_top.Count == 0)
                    {
                        <div class="list-row"><span class="muted">@T("home.todavia_no_hay_ventas_esta")</span></div>
                    }
                    @foreach (var item in _top)
                    {
                        <div class="list-row">
                            <Avatar Text="@item.Name" Size="36" />
                            <div class="two-line"><span class="t1">@item.Name</span><span class="t2">@T("home.vendidos", Fmt.Qty(item.Quantity))</span></div>
                            <strong class="end">@Fmt.Money(item.Total, _summary?.CurrencyCode ?? "PEN")</strong>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private DashboardSummary? _summary;
    private CashSessionRow? _cash;
    private IReadOnlyList<SaleRow> _recent = [];
    private IReadOnlyList<TopItem> _top = [];

    private string FirstName => Session.UserName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "";

    protected override async Task LoadAsync()
    {
        _summary = await Pos.Sales.GetDashboardAsync();
        _cash = await Pos.Cash.GetOpenAsync();
        _recent = (await Pos.Sales.GetSalesAsync(new SaleQuery(PageSize: 8))).Items;
        _top = await Pos.Sales.GetTopItemsAsync();
    }
}
