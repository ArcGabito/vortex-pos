@page "/caja"
@inherits PosPage
@inject IJSRuntime JS

<SectionContent SectionName="page-title">@T("register.vender")</SectionContent>

@if (Loading)
{
    <div class="boot"><div class="spinner"></div></div>
}
else if (_session is null)
{
    <div class="page">
        <EmptyState Icon="lock" Title="@(T("register.la_caja_esta_cerrada"))" Text="@(T("register.abre_un_turno_con_el"))">
            <a class="btn btn-dark" href="turnos?abrir=1"><Icon Name="unlock" Size="18" />@T("register.abrir_caja")</a>
        </EmptyState>
    </div>
}
else
{
    <div class="register">
        <section class="register-catalog">
            <ItemPicker @ref="_picker" SiteId="_session.SiteId" OnSelected="Add" OnCode="ScanAsync" />
            @if (_categories.Count > 0)
            {
                <div class="chips">
                    <button class="chip @(_category == "" ? "on" : "")" @onclick="@(() => SetCategoryAsync(""))">@T("register.todo")</button>
                    @foreach (var category in _categories)
                    {
                        <button class="chip @(_category == category ? "on" : "")" @onclick="() => SetCategoryAsync(category)">@category</button>
                    }
                </div>
            }
            @if (_tiles.Count == 0)
            {
                <EmptyState Icon="tag" Title="@(T("register.no_hay_articulos"))" Text="@(T("register.el_catalogo_llega_desde_el"))" />
            }
            else
            {
                <div class="tiles">
                    @foreach (var item in _tiles)
                    {
                        <button class="tile" @key="item.Id" @onclick="() => Add(item)">
                            <Avatar Text="@item.Name" Size="38" Class="square" />
                            <span class="name">@item.Name</span>
                            <span class="price">@Fmt.Money(item.Price, item.CurrencyCode)</span>
                            @if (item.TrackInventory && item.OnHand is { } onHand)
                            {
                                <span class="stock @(onHand <= 0 ? "out" : "")">@T("register.en_tienda", Fmt.Qty(onHand))</span>
                            }
                        </button>
                    }
                </div>
            }
        </section>

        <aside class="card register-cart" id="venta-actual">
            <div class="card-head">
                <div>
                    <h3>@T("register.venta_actual")</h3>
                    <div class="sub">@_session.SiteName · @_session.Number</div>
                </div>
                <div style="display:flex;gap:4px">
                    @if (_held.Count > 0)
                    {
                        <button class="btn btn-sm" @onclick="() => _showHeld = true" title="@(T("register.tickets_en_espera"))"><Icon Name="clock" Size="16" />@_held.Count</button>
                    }
                    @if (_cart.Count > 0)
                    {
                        <button class="btn btn-ghost btn-sm" @onclick="StartHold" title="@(T("register.poner_en_espera"))"><Icon Name="clock" Size="16" />@T("register.en_espera")</button>
                        <button class="btn btn-ghost btn-sm" @onclick="Clear"><Icon Name="trash" Size="16" />@T("register.vaciar")</button>
                    }
                </div>
            </div>
            <div class="card-body cart-body">
                <div class="field">
                    <label>@T("register.cliente")</label>
                    <select class="select" @bind="_customerId">
                        <option value="">@T("register.clientes_varios")</option>
                        @foreach (var c in _customers)
                        {
                            <option value="@c.Id">@c.Label@(c.Detail is null ? "" : $" · {c.Detail}")</option>
                        }
                    </select>
                </div>

                @if (_cart.Count == 0)
                {
                    <div class="cart-empty">
                        <Icon Name="cart" Size="28" />
                        <span>@T("register.escanea_un_codigo_toca_un")</span>
                    </div>
                }
                else
                {
                    <div class="cart-lines">
                        @foreach (var line in _cart)
                        {
                            <div class="cart-line" @key="line">
                                <div class="two-line">
                                    <span class="t1">@line.Item.Name@(line.Presentation is { } pr ? $" · {pr.Name}" : "")</span>
                                    <span class="t2">
                                        @if (line.PriceChanged)
                                        {
                                            <s class="faint">@Fmt.Money(line.Item.Price, line.Item.CurrencyCode)</s>
                                        }
                                        @Fmt.Money(line.UnitPrice, line.Item.CurrencyCode) @(line.Weighed ? $"/ {line.Item.Unit}" : "c/u")@(line.Discount > 0 ? $" · −{Fmt.Money(line.Discount, line.Item.CurrencyCode)}" : "")
                                    </span>
                                </div>
                                <div class="qty">
                                    <button class="btn btn-ghost icon-btn sm" @onclick="() => Step(line, -1)" aria-label="@(T("register.quitar_uno"))"><Icon Name="minus" Size="16" /></button>
                                    <input class="control" type="number" min="0" step="any" @bind="line.Quantity" @bind:event="oninput" aria-label="@(T("register.cantidad"))" />
                                    <button class="btn btn-ghost icon-btn sm" @onclick="() => Step(line, 1)" aria-label="@(T("register.agregar_uno"))"><Icon Name="plus" Size="16" /></button>
                                </div>
                                <strong class="amount">@Fmt.Money(line.Total, line.Item.CurrencyCode)</strong>
                                <KebabMenu>
                                    <button @onclick="() => EditDiscount(line)"><Icon Name="tag" Size="18" />@T("register.descuento")</button>
                                    <button @onclick="() => EditPrice(line)"><Icon Name="edit" Size="18" />@T("register.cambiar_precio")</button>
                                    <button class="danger" @onclick="() => _cart.Remove(line)"><Icon Name="x" Size="18" />@T("register.quitar")</button>
                                </KebabMenu>
                            </div>
                        }
                    </div>
                }

                <dl class="totals">
                    <dt>@T("register.subtotal")</dt><dd>@Fmt.Money(Totals.Subtotal, Currency)</dd>
                    <dt>@_regime.TaxName@(_regime.PricesIncludeTax ? T("register.incluido") : "")</dt><dd>@Fmt.Money(Totals.Tax, Currency)</dd>
                    @if (Totals.Discount > 0)
                    {
                        <dt>@T("register.descuentos")</dt><dd>−@Fmt.Money(Totals.Discount, Currency)</dd>
                    }
                    <dt class="grand">@T("register.total")</dt><dd class="grand">@Fmt.Money(Totals.Total, Currency)</dd>
                </dl>
                <button class="btn btn-accent btn-block btn-lg" disabled="@(!CanCharge)" @onclick="OpenPayment">
                    <Icon Name="cash" Size="20" />@T("register.cobrar", (Fmt.Money(Totals.Total, Currency)))
                </button>
            </div>
        </aside>
    </div>

    @if (_cart.Count > 0)
    {
        @* Celular: la venta queda debajo del catálogo; esta barra la muestra y cobra sin buscarla. *@
        <div class="cart-dock">
            <button class="cart-dock-info" @onclick='() => JS.InvokeVoidAsync("vortex.scrollTo", "venta-actual")'>
                <Icon Name="cart" Size="18" />
                <span>@T("register.n_en_la_venta", Fmt.Qty(_cart.Sum(l => l.Quantity)))</span>
            </button>
            <button class="btn btn-accent" disabled="@(!CanCharge)" @onclick="OpenPayment">@T("register.cobrar", (Fmt.Money(Totals.Total, Currency)))</button>
        </div>
    }
}

@if (_priceFor is { } pf)
{
    <Modal Title="@(T("register.cambiar_precio"))" Subtitle="@pf.Item.Name" Size="sm" Error="@_error" OnClose="() => _priceFor = null">
        <ChildContent>
            <div class="field">
                <label>@T("register.precio_unitario", Fmt.Symbol(pf.Item.CurrencyCode))</label>
                <input class="control" type="number" inputmode="decimal" min="0" step="0.10" @bind="_price" />
                <span class="hint">@T("register.precio_de_lista", Fmt.Money(pf.Item.Price, pf.Item.CurrencyCode))</span>
            </div>
            @if (!Session.Can(PosPermissions.ChangePrice))
            {
                <div class="alert info"><Icon Name="lock" Size="18" /><span>@T("register.precio_lo_autoriza")</span></div>
            }
        </ChildContent>
        <Footer>
            @if (pf.PriceChanged)
            {
                <button class="btn btn-ghost" @onclick="() => { pf.UnitPrice = pf.Item.Price; _priceFor = null; }">@T("register.volver_al_de_lista")</button>
            }
            <button class="btn" @onclick="() => _priceFor = null">@T("register.cancelar")</button>
            <button class="btn btn-dark" @onclick="ApplyPrice">@T("register.aplicar")</button>
        </Footer>
    </Modal>
}

@if (_discountFor is { } d)
{
    <Modal Title="@(T("register.descuento"))" Subtitle="@d.Item.Name" Size="sm" Error="@_error" OnClose="() => _discountFor = null">
        <ChildContent>
            <div class="field">
                <label>@T("register.monto_de_descuento_de_la", Fmt.Symbol(d.Item.CurrencyCode))</label>
                <input class="control" type="number" min="0" step="0.10" @bind="_discount" />
            </div>
        </ChildContent>
        <Footer>
            <button class="btn" @onclick="() => _discountFor = null">@T("register.cancelar")</button>
            <button class="btn btn-dark" @onclick="ApplyDiscount">@T("register.aplicar")</button>
        </Footer>
    </Modal>
}

@if (_paying)
{
    <Modal Title="@(T("register.cobrar", (Fmt.Money(Totals.Total, Currency))))" Subtitle="@(T("register.puedes_combinar_medios_de_pago"))" Error="@_error" OnClose="() => _paying = false">
        <ChildContent>
            <div class="methods">
                @foreach (var method in PaymentMethods.All)
                {
                    <button class="method @(_payments.ContainsKey(method) ? "on" : "")" @onclick="() => ToggleMethod(method)"
                            disabled="@(method == PaymentMethods.Credit && _customerId is null)"
                            title="@(method == PaymentMethods.Credit && _customerId is null ? T("register.elige_un_cliente_para_vender") : null)">
                        <Icon Name="@Fmt.PaymentIcon(method)" Size="22" />@Fmt.PaymentMethod(method)
                    </button>
                }
            </div>
            @foreach (var (method, amount) in _payments)
            {
                var m = method;
                <div class="form-row">
                    <div class="field">
                        <label>@(m == PaymentMethods.Cash ? T("register.efectivo_recibido") : Fmt.PaymentMethod(m))</label>
                        <input class="control" type="number" min="0" step="0.10" value="@amount"
                               @onchange="e => _payments[m] = decimal.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var v) ? v : 0" />
                    </div>
                    @if (m == PaymentMethods.Cash)
                    {
                        <div class="field">
                            <label>@T("register.billetes_rapidos")</label>
                            <div style="display:flex;gap:6px;flex-wrap:wrap">
                                @foreach (var bill in QuickCash())
                                {
                                    <button class="btn btn-sm" @onclick="() => _payments[m] = bill">@bill.ToString("0.##", Fmt.Culture)</button>
                                }
                            </div>
                        </div>
                    }
                    else if (m is PaymentMethods.Card or PaymentMethods.Transfer or PaymentMethods.Wallet)
                    {
                        <div class="field">
                            <label>@T("register.referencia_opcional")</label>
                            <input class="control" placeholder="@(m == PaymentMethods.Card ? T("register.visa_1234") : T("register.de_operacion"))" @bind="_references[m]" />
                        </div>
                    }
                </div>
            }
            <dl class="totals">
                <dt>@T("register.total")</dt><dd>@Fmt.Money(Totals.Total, Currency)</dd>
                <dt>@T("register.pagado")</dt><dd>@Fmt.Money(Paid, Currency)</dd>
                @if (Paid >= Totals.Total)
                {
                    <dt class="grand">@T("register.vuelto")</dt><dd class="grand good-text">@Fmt.Money(Paid - Totals.Total, Currency)</dd>
                }
                else
                {
                    <dt class="grand">@T("register.falta")</dt><dd class="grand warn-text">@Fmt.Money(Totals.Total - Paid, Currency)</dd>
                }
            </dl>
        </ChildContent>
        <Footer>
            <button class="btn" @onclick="() => _paying = false">@T("register.volver")</button>
            <button class="btn btn-dark" disabled="@(_busy || Paid < Totals.Total)" @onclick="ChargeAsync"><Icon Name="check" Size="18" />@T("register.confirmar_cobro")</button>
        </Footer>
    </Modal>
}

@if (_receipt is { } r)
{
    <Modal Title="@(T("register.venta_registrada"))" Subtitle="@r.Number" Size="sm" OnClose="NewSale">
        <ChildContent>
            <div class="receipt-done">
                <div class="em-icon"><Icon Name="check" Size="28" Stroke="2.4" /></div>
                <strong>@Fmt.Money(r.Total, Currency)</strong>
                @if (r.Change > 0)
                {
                    <span class="change">@T("register.vuelto_2") <b>@Fmt.Money(r.Change, Currency)</b></span>
                }
                <span class="muted">@T("register.se_guardo_en_este_equipo")</span>
            </div>
        </ChildContent>
        <Footer>
            <button class="btn" @onclick="() => PrintSaleAsync(r.SaleId)"><Icon Name="receipt" Size="18" />@T("register.imprimir_ticket")</button>
            <button class="btn btn-dark" @onclick="NewSale">@T("register.nueva_venta")</button>
        </Footer>
    </Modal>
}

@if (_holding)
{
    <Modal Title="@(T("register.poner_en_espera"))" Subtitle="@(T("register.la_caja_queda_libre_para"))" Size="sm" Error="@_error" OnClose="() => _holding = false">
        <ChildContent>
            <div class="field">
                <label>@T("register.para_reconocerlo_opcional")</label>
                <input class="control" placeholder="@(T("register.ej_senora_de_rojo"))" @bind="_holdLabel" />
            </div>
        </ChildContent>
        <Footer>
            <button class="btn" @onclick="() => _holding = false">@T("register.volver")</button>
            <button class="btn btn-dark" disabled="@_busy" @onclick="HoldAsync"><Icon Name="clock" Size="18" />@T("register.poner_en_espera")</button>
        </Footer>
    </Modal>
}

@if (_showHeld)
{
    <Modal Title="@(T("register.tickets_en_espera"))" Subtitle="@(T("register.retoma_uno_para_seguir_cobrando"))" OnClose="() => _showHeld = false">
        <ChildContent>
            @foreach (var h in _held)
            {
                <div class="list-row" @key="h.Id">
                    <div class="two-line">
                        <span class="t1">@(h.Label ?? h.CustomerName ?? T("register.ticket_de", Fmt.Time(h.CreatedAt)))</span>
                        <span class="t2">@Fmt.Count(h.Lines, T("count.articulo"), T("count.articulos")) · @Fmt.Ago(h.CreatedAt)@(h.UserName is null ? "" : $" · {h.UserName}")</span>
                    </div>
                    <strong class="end">@Fmt.Money(h.Total, Currency)</strong>
                    <button class="btn btn-ghost icon-btn sm" @onclick="() => DiscardHeldAsync(h)" aria-label="@(T("register.descartar"))" title="@(T("register.descartar"))"><Icon Name="trash" Size="16" /></button>
                    <button class="btn btn-dark btn-sm" @onclick="() => ResumeHeldAsync(h)">@T("register.retomar")</button>
                </div>
            }
            @if (_cart.Count > 0)
            {
                <div class="alert info"><Icon Name="alert" Size="18" /><span>@T("register.al_retomar_la_venta_actual")</span></div>
            }
        </ChildContent>
    </Modal>
}

@code {
    private sealed class CartItem
    {
        public required ItemRow Item { get; init; }
        public decimal Quantity { get; set; } = 1;
        public decimal UnitPrice { get; set; }
        public decimal Discount { get; set; }
        public ItemPresentationRow? Presentation { get; init; }
        public bool Weighed { get; init; }
        public bool PriceChanged => UnitPrice != Item.Price;
        public decimal Step => Presentation?.Factor ?? 1;
        public CartLine ToLine() => new(Item.Id, Quantity, UnitPrice, Math.Min(Discount, Quantity * UnitPrice), Presentation?.Code);
        public decimal Total => Quantity > 0 ? SalesService.LineTotal(Quantity, UnitPrice, Math.Min(Discount, Quantity * UnitPrice), Item.CurrencyCode) : 0;
    }

    private CashSessionRow? _session;
    private IReadOnlyList<string> _categories = [];
    private IReadOnlyList<ItemRow> _tiles = [];
    private IReadOnlyList<Option> _customers = [];
    private string _category = "";
    private readonly List<CartItem> _cart = [];
    private Guid? _customerId;
    private ItemPicker? _picker;

    private CartItem? _discountFor, _priceFor;
    private decimal _discount, _price;
    private bool _paying, _busy;
    private readonly Dictionary<string, decimal> _payments = [];
    private readonly Dictionary<string, string?> _references = [];
    private SaleReceipt? _receipt;
    private string? _error;
    private IReadOnlyList<HeldSaleRow> _held = [];
    private StoreSettings _store = StoreSettings.Default;
    private bool _holding, _showHeld;
    private string? _holdLabel;

    private string Currency => _cart.FirstOrDefault()?.Item.CurrencyCode ?? "PEN";
    private SaleTotals Totals => SalesService.Totals(_cart.Where(l => l.Quantity > 0).Select(l => (l.Total, Math.Min(l.Discount, l.Quantity * l.UnitPrice), l.Item.TaxCode)),
        _regime, Currency);
    private VortexApi.Suite.Taxes.TaxRegime _regime = VortexApi.Suite.Taxes.TaxCatalog.For("PE");
    private decimal Paid => _payments.Values.Sum();
    private bool CanCharge => _cart.Any(l => l.Quantity > 0) && _cart.All(l => l.Quantity >= 0);

    protected override async Task LoadAsync()
    {
        _session = await Pos.Cash.GetOpenAsync();
        _regime = await Pos.Sales.GetTaxRegimeAsync();
        _held = await Pos.Sales.GetHeldAsync();
        if (_session is null)
            return;
        _categories = await Pos.Master.GetCategoriesAsync();
        _customers = await Pos.Master.GetPartyOptionsAsync(suppliers: false);
        _store = await Pos.Stores.GetAsync(_session.SiteId);
        await LoadTilesAsync();
    }

    private async Task LoadTilesAsync() =>
        _tiles = (await Pos.Master.GetItemsAsync(null, _category == "" ? null : _category, 1, 24, includeInactive: false, _session?.SiteId)).Items;

    private async Task SetCategoryAsync(string category)
    {
        _category = category;
        await LoadTilesAsync();
    }

    private void Add(ItemRow item) => Add(new ScanMatch(item, 1));

    /// <summary>
    /// Suma lo escaneado a la venta: la misma presentación se acumula en su línea; cada etiqueta de balanza es una
    /// línea propia (su peso es el de ese paquete).
    /// </summary>
    private void Add(ScanMatch match)
    {
        if (!match.Weighed && _cart.FirstOrDefault(l => !l.Weighed && l.Item.Id == match.Item.Id && l.Presentation?.Code == match.Presentation?.Code) is { } existing)
            existing.Quantity += match.Quantity;
        else
            _cart.Add(new CartItem { Item = match.Item, UnitPrice = match.Item.Price, Quantity = match.Quantity, Presentation = match.Presentation, Weighed = match.Weighed });
    }

    private async Task<bool> ScanAsync(string code)
    {
        if (await Pos.Master.ResolveScanAsync(code, _session?.SiteId) is not { } match)
            return false;
        Add(match);
        StateHasChanged();
        return true;
    }

    private void Step(CartItem line, int delta)
    {
        line.Quantity = Math.Max(0, line.Quantity + delta * line.Step);
        if (line.Quantity == 0)
            _cart.Remove(line);
    }

    private void EditPrice(CartItem line)
    {
        _error = null;
        _price = line.UnitPrice;
        _priceFor = line;
    }

    /// <summary>El permiso se revisa al cobrar: si el cajero no lo tiene, ahí se pide el PIN del supervisor.</summary>
    private void ApplyPrice()
    {
        if (_priceFor is not { } line)
            return;
        if (_price < 0)
        {
            _error = T("register.el_precio_no_puede_ser_negativo");
            return;
        }
        line.UnitPrice = _price;
        line.Discount = Math.Min(line.Discount, line.Quantity * line.UnitPrice);
        _priceFor = null;
    }

    private void Clear()
    {
        _cart.Clear();
        _customerId = null;
    }

    private void EditDiscount(CartItem line)
    {
        _error = null;
        _discount = line.Discount;
        _discountFor = line;
    }

    private void ApplyDiscount()
    {
        if (_discountFor is not { } line)
            return;
        if (_discount < 0 || _discount > line.Quantity * line.UnitPrice)
        {
            _error = T("register.el_descuento_debe_estar_entre");
            return;
        }
        line.Discount = _discount;
        _discountFor = null;
    }

    private void OpenPayment()
    {
        _error = null;
        _payments.Clear();
        _references.Clear();
        _payments[PaymentMethods.Cash] = Totals.Total;
        _paying = true;
    }

    private void ToggleMethod(string method)
    {
        if (!_payments.Remove(method))
            _payments[method] = Math.Max(0, Totals.Total - Paid);
        _references.TryAdd(method, null);
    }

    /// <summary>Monto exacto y los billetes de sol que alcanzan para pagar.</summary>
    private IEnumerable<decimal> QuickCash()
    {
        var due = Totals.Total - _payments.Where(p => p.Key != PaymentMethods.Cash).Sum(p => p.Value);
        return new[] { due }.Concat(new decimal[] { 10, 20, 50, 100, 200 }.Where(b => b > due)).Where(b => b > 0).Distinct().Take(5);
    }

    private async Task ChargeAsync()
    {
        var draft = new SaleDraft(
            _cart.Where(l => l.Quantity > 0).Select(l => l.ToLine()).ToList(),
            _payments.Where(p => p.Value > 0).Select(p => new PaymentDraft(p.Key, p.Value, _references.GetValueOrDefault(p.Key))).ToList(),
            _customerId);
        _busy = true;
        SaleReceipt? receipt = null;
        _error = await TryAsync(async () => receipt = await Pos.Sales.CheckoutAsync(draft));
        _busy = false;
        if (_error is null)
        {
            _paying = false;
            _receipt = receipt;
            if (_store.PrintAutomatically && Printer.IsConfigured)
                await PrintSaleAsync(receipt!.SaleId);
        }
    }

    // ---------- Tickets en espera ----------

    private void StartHold()
    {
        _error = null;
        _holdLabel = null;
        _holding = true;
    }

    private async Task HoldAsync()
    {
        var lines = _cart.Where(l => l.Quantity > 0)
            .Select(l => l.ToLine()).ToList();
        _busy = true;
        _error = await TryAsync(() => Pos.Sales.HoldAsync(lines, _customerId, _holdLabel), T("register.ticket_en_espera"));
        _busy = false;
        if (_error is not null)
            return;
        _holding = false;
        Clear();
        _held = await Pos.Sales.GetHeldAsync();
    }

    /// <summary>Retoma un ticket en espera. Si había una venta a medias, queda en espera en su lugar.</summary>
    private async Task ResumeHeldAsync(HeldSaleRow row)
    {
        if (_cart.Count > 0)
        {
            var current = _cart.Where(l => l.Quantity > 0)
                .Select(l => l.ToLine()).ToList();
            if (current.Count > 0 && await TryAsync(() => Pos.Sales.HoldAsync(current, _customerId, null)) is { } holdError)
            {
                Toasts.Error(holdError);
                return;
            }
        }
        HeldSale? held = null;
        if (await TryAsync(async () => held = await Pos.Sales.ResumeHeldAsync(row.Id)) is { } error)
        {
            Toasts.Error(error);
            return;
        }
        Clear();
        foreach (var line in held!.Lines)
        {
            if (await Pos.Master.GetItemAsync(line.ItemId, _session?.SiteId) is { } item)
            {
                var presentation = line.Presentation is { } code
                    ? (await Pos.Master.GetPresentationsAsync(item.Id)).FirstOrDefault(p => p.Code == code)
                    : null;
                _cart.Add(new CartItem
                {
                    Item = item, Quantity = line.Quantity, UnitPrice = line.UnitPrice ?? item.Price, Discount = line.Discount,
                    Presentation = presentation, Weighed = presentation is null && line.Quantity % 1 != 0,
                });
            }
        }
        _customerId = held.CustomerId;
        _held = await Pos.Sales.GetHeldAsync();
        _showHeld = false;
    }

    private async Task DiscardHeldAsync(HeldSaleRow row)
    {
        await Pos.Sales.DiscardHeldAsync(row.Id);
        _held = await Pos.Sales.GetHeldAsync();
        if (_held.Count == 0)
            _showHeld = false;
    }

    private async Task NewSale()
    {
        _receipt = null;
        Clear();
        if (_picker is not null)
            await _picker.FocusAsync();
    }
}
