@* Estado con punto + texto (el color nunca va solo). Tonos: good, info, warn, bad, neutral, accent. *@
<span class="pill @Tone @(Plain ? "plain" : "")">@Text</span>

@code {
    [Parameter, EditorRequired] public string Text { get; set; } = "";
    [Parameter] public string Tone { get; set; } = "neutral";
    [Parameter] public bool Plain { get; set; }

    public static (string Text, string Tone) ForSale(SaleRow sale) =>
        sale.Status == SaleStatuses.Voided ? (T("statuspill.anulada"), "bad")
        : sale.Returned >= sale.Total && sale.Total > 0 ? (T("statuspill.devuelta"), "neutral")
        : sale.Returned > 0 ? (T("statuspill.devolucion_parcial"), "warn")
        : (T("statuspill.pagada"), "good");

    /// <summary>Estado del comprobante electrónico ante SUNAT.</summary>
    public static (string Text, string Tone) ForFiscal(string? status) => status switch
    {
        FiscalStatuses.Accepted => (T("statuspill.fiscal_aceptado"), "good"),
        FiscalStatuses.Observed => (T("statuspill.fiscal_observado"), "warn"),
        FiscalStatuses.Rejected => (T("statuspill.fiscal_rechazado"), "bad"),
        FiscalStatuses.Failed or FiscalStatuses.Error => (T("statuspill.fiscal_error"), "bad"),
        _ => (T("statuspill.fiscal_pendiente"), "neutral"),
    };

    public static (string Text, string Tone) ForStock(decimal? onHand) => onHand switch
    {
        null => (T("statuspill.sin_dato"), "neutral"),
        <= 0 => ("Agotado", "bad"),
        < 5 => ("Pocas unidades", "warn"),
        _ => (T("statuspill.en_stock"), "good"),
    };
}
