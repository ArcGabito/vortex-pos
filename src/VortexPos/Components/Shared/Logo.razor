@* Marca: bolsa de compras (asa morada, cuerpo en tinta) + "vortexpos". *@
<div class="logo @(OnDark ? "on-dark" : "")">
    <svg width="@Size" height="@Size" viewBox="0 0 48 48" aria-hidden="true">
        <path d="M17 15 V12 a7 7 0 0 1 14 0 V15" fill="none" stroke="#512BD4" stroke-width="3.6" stroke-linecap="round" />
        <path d="M9 15 H39 L36.5 42 a3 3 0 0 1 -3 2.7 H14.5 a3 3 0 0 1 -3 -2.7 Z" fill="@(OnDark ? "#FFFFFF" : "#1C120D")" />
        <path d="M9 15 H39 L38.3 22.5 H9.7 Z" fill="#512BD4" />
        <circle cx="24" cy="32" r="4.2" fill="@(OnDark ? "#C7B8F5" : "#6D4AE0")" />
    </svg>
    @if (!IconOnly)
    {
        <span class="word">vortex<b>pos</b></span>
    }
</div>

@code {
    [Parameter] public int Size { get; set; } = 34;
    [Parameter] public bool OnDark { get; set; }
    [Parameter] public bool IconOnly { get; set; }
}
